<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Исполнитель</dataPath>
			<field>Исполнитель</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номер</dataPath>
			<field>Номер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПериодОхоты</dataPath>
			<field>ПериодОхоты</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВидДичи</dataPath>
			<field>ВидДичи</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МестоОхоты</dataPath>
			<field>МестоОхоты</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Серия</dataPath>
			<field>Серия</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Охотник</dataPath>
			<field>Охотник</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Охотник</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Охотхозяйство</dataPath>
			<field>Охотхозяйство</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КолСезонная</dataPath>
			<field>КолСезонная</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Кол сезонная</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаСезонная</dataPath>
			<field>СуммаСезонная</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма сезонная</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КолРазовая</dataPath>
			<field>КолРазовая</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Кол разовая</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаРазовая</dataPath>
			<field>СуммаРазовая</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма разовая</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОтчетныйВидДичи</dataPath>
			<field>ОтчетныйВидДичи</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПродажаПутевок.Регистратор.Охотник КАК Охотник,
	ВЫБОР
		КОГДА ПродажаПутевок.Регистратор.Сезонная
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК КолСезонная,
	ВЫБОР
		КОГДА ПродажаПутевок.Регистратор.Сезонная
			ТОГДА ПродажаПутевок.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаСезонная,
	ВЫБОР
		КОГДА ПродажаПутевок.Регистратор.Сезонная
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК КолРазовая,
	ВЫБОР
		КОГДА ПродажаПутевок.Регистратор.Сезонная
			ТОГДА 0
		ИНАЧЕ ПродажаПутевок.Сумма
	КОНЕЦ КАК СуммаРазовая,
	ПродажаПутевок.Охотхозяйство,
	ПродажаПутевок.МестоОхоты,
	ПродажаПутевок.ВидДичи,
	ПродажаПутевок.ОтчетныйВидДичи,
	ПродажаПутевок.Серия,
	ПродажаПутевок.Номер,
	ПродажаПутевок.ПериодОхоты,
	ПродажаПутевок.Исполнитель
ИЗ
	РегистрНакопления.ПродажаПутевок КАК ПродажаПутевок
ГДЕ
	НЕ ПродажаПутевок.Регистратор.ПометкаУдаления
{ГДЕ
	(ПродажаПутевок.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания),
	(ПродажаПутевок.Охотхозяйство В (&amp;ОхотхозяйствоПользователя)),
	(ПродажаПутевок.ВидДичи В (&amp;ВидДичи)),
	(ПродажаПутевок.ОтчетныйВидДичи В (&amp;ОтчетныйВидДичи)),
	(ПродажаПутевок.МестоОхоты В (&amp;МестоОхоты))}</query>
	</dataSet>
	<calculatedField>
		<dataPath>КолПутевок</dataPath>
		<expression>КолРазовая + КолСезонная</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Кол путевок</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>СуммаПутевок</dataPath>
		<expression>СуммаРазовая + СуммаСезонная</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сумма путевок</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>КолПутевокО</dataPath>
		<expression>КолРазовая + КолСезонная</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Кол путевок О</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>СуммаПутевокО</dataPath>
		<expression>СуммаРазовая + СуммаСезонная</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сумма путевок О</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>КолРазовая</dataPath>
		<expression>Сумма(КолРазовая)</expression>
		<group>Охотхозяйство</group>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>КолСезонная</dataPath>
		<expression>Сумма(КолСезонная)</expression>
		<group>Охотхозяйство</group>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>СуммаРазовая</dataPath>
		<expression>Сумма(СуммаРазовая)</expression>
		<group>Охотхозяйство</group>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>СуммаСезонная</dataPath>
		<expression>Сумма(СуммаСезонная)</expression>
		<group>ВидДичи</group>
		<group>Охотхозяйство</group>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>КолПутевок</dataPath>
		<expression>Сумма(КолПутевок)</expression>
		<group>ВидДичи</group>
		<group>Исполнитель</group>
		<group>Охотхозяйство</group>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>СуммаПутевок</dataPath>
		<expression>Сумма(СуммаПутевок)</expression>
		<group>ВидДичи</group>
		<group>Исполнитель</group>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>КолПутевокО</dataPath>
		<expression>Сумма(КолПутевокО)</expression>
		<group>Исполнитель</group>
		<group>ОтчетныйВидДичи</group>
		<group>Охотхозяйство</group>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>СуммаПутевокО</dataPath>
		<expression>Сумма(СуммаПутевокО)</expression>
		<group>Исполнитель</group>
		<group>ОтчетныйВидДичи</group>
		<group>ОбщийИтог</group>
	</totalField>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ПериодОтчета.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>ДатаОкончания</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата окончания</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ПериодОтчета.ДатаОкончания</expression>
	</parameter>
	<parameter>
		<name>ПериодОтчета</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период отчета</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">Custom</v8:variant>
			<v8:startDate>0001-01-01T00:00:00</v8:startDate>
			<v8:endDate>0001-01-01T00:00:00</v8:endDate>
		</value>
		<useRestriction>true</useRestriction>
	</parameter>
	<parameter>
		<name>ОхотхозяйствоПользователя</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Охотхозяйство пользователя</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.Охотхозяйства</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>МестоОхоты</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Место охоты</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.Охотхозяйства</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>ВидДичи</name>
