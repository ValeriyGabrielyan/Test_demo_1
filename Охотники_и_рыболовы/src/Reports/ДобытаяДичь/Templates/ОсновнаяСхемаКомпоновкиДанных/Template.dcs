	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>МестоОхоты</dataPath>
			<field>МестоОхоты</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Дичь</dataPath>
			<field>Дичь</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Охотник</dataPath>
			<field>Охотник</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВидДичи</dataPath>
			<field>ВидДичи</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вид дичи</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Охотхозяйство</dataPath>
			<field>Охотхозяйство</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Охотхозяйство</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ДобытаяДичьОбороты.Охотник,
	ДобытаяДичьОбороты.МестоОхоты,
	ДобытаяДичьОбороты.Дичь,
	ДобытаяДичьОбороты.КоличествоОборот КАК Количество,
	ДобытаяДичьОбороты.Регистратор.Охотхозяйство КАК Охотхозяйство,
	ДобытаяДичьОбороты.Регистратор.ВидДичи КАК ВидДичи
ИЗ
	РегистрНакопления.ДобытаяДичь.Обороты(, , Регистратор, ) КАК ДобытаяДичьОбороты
{ГДЕ
	(ДобытаяДичьОбороты.МестоОхоты = &amp;ОхотхозяйствоПользователя)}</query>
	</dataSet>
	<calculatedField>
		<dataPath>КоличествоОхотхоз</dataPath>
