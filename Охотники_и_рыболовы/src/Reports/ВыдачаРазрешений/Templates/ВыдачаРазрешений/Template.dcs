<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Исполнитель</dataPath>
			<field>Исполнитель</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Охотхозяйство</dataPath>
			<field>Охотхозяйство</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номер</dataPath>
			<field>Номер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПериодОхоты</dataPath>
			<field>ПериодОхоты</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВидДичи</dataPath>
			<field>ВидДичи</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Период</dataPath>
			<field>Период</field>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МестоОхоты</dataPath>
			<field>МестоОхоты</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Серия</dataPath>
			<field>Серия</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Охотник</dataPath>
			<field>Охотник</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Охотник</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОтчетныйВидДичи</dataPath>
			<field>ОтчетныйВидДичи</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоАктов</dataPath>
			<field>КоличествоАктов</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество актов</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоСданных</dataPath>
			<field>КоличествоСданных</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество сданных</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НеСданные</dataPath>
			<field>НеСданные</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Не сданные</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВыдачаРазрешений.Период КАК Период,
	ВыдачаРазрешений.Регистратор.Охотник КАК Охотник,
	ВыдачаРазрешений.Охотхозяйство,
	ВыдачаРазрешений.МестоОхоты,
	ВыдачаРазрешений.ВидДичи,
	ВыдачаРазрешений.Серия,
	ВыдачаРазрешений.Номер,
	ВыдачаРазрешений.ПериодОхоты,
	ВыдачаРазрешений.Исполнитель,
	ВыдачаРазрешений.ОтчетныйВидДичи,
	ВЫБОР
		КОГДА ВыдачаРазрешений.Регистратор.Сдан
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоСданных,
	ВЫБОР
		КОГДА ВыдачаРазрешений.Регистратор.АктМПР
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоАктов,
	ВЫБОР
		КОГДА НЕ ВыдачаРазрешений.Регистратор.Сдан
				И НЕ ВыдачаРазрешений.Регистратор.АктМПР
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК НеСданные
ИЗ
	РегистрНакопления.ВыдачаРазрешений КАК ВыдачаРазрешений
ГДЕ
	НЕ ВыдачаРазрешений.Регистратор.ПометкаУдаления
{ГДЕ
	(ВыдачаРазрешений.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания),
	(ВыдачаРазрешений.Охотхозяйство В (&amp;ОхотхозяйствоПользователя)),
	(ВыдачаРазрешений.ВидДичи В (&amp;ВидДичи)),
	(ВыдачаРазрешений.ОтчетныйВидДичи В (&amp;ОтчетныйВидДичи)),
	(ВыдачаРазрешений.МестоОхоты В (&amp;МестоОхоты))}

УПОРЯДОЧИТЬ ПО
	Период</query>
	</dataSet>
	<calculatedField>
		<dataPath>Выдано</dataPath>
		<expression>1</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Выдано</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>КоличествоАктов</dataPath>
		<expression>Сумма(КоличествоАктов)</expression>
		<group>ВидДичи</group>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>КоличествоСданных</dataPath>
