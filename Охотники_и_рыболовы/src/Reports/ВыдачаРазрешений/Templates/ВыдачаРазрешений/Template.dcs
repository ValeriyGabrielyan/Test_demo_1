		<group>ВидДичи</group>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>Выдано</dataPath>
		<expression>Сумма(Выдано)</expression>
		<group>ВидДичи</group>
		<group>ОбщийИтог</group>
	</totalField>
