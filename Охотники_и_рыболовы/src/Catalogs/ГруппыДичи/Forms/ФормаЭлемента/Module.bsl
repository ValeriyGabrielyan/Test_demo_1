
&НаКлиенте
Процедура СоставДичьПриИзменении(Элемент)
	Если Объект.Состав.Количество() = 0 Тогда
		Возврат;
	Иначе
		Наименование = "";
		Для каждого стр из Объект.Состав Цикл
			Наименование = Наименование + стр.Дичь + ", ";	
		КонецЦикла;
		Объект.Наименование = Лев(Наименование,СтрДлина(Наименование) - 2);	
	КонецЕсли;
КонецПроцедуры


