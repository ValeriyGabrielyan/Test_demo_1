    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникОхотники.Ссылка КАК Охотник,
	СправочникОхотники.ДатаРождения КАК ДатаРождения,
	ЕСТЬNULL(СправочникОхотники.СерияГосБилета, &quot;&quot;) КАК Серия,
	ЕСТЬNULL(СправочникОхотники.НомерГосБилета, &quot;&quot;) КАК Номер,
	ВЫБОР
		КОГДА ЕСТЬNULL(СправочникОхотники.СерияГосБилета, &quot;&quot;) = &quot;&quot;
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК Действует,
	ЕСТЬNULL(СправочникОхотники.Охотхозяйство, ЗНАЧЕНИЕ(Справочник.Охотхозяйства.ПустаяСсылка)) КАК ЗарегистрированВ
ИЗ
	Справочник.Охотники КАК СправочникОхотники</queryText>
      <mainTable>Catalog.Охотники</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
