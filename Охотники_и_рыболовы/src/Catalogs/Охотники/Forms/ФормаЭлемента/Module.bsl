КонецПроцедуры

&НаКлиенте
Процедура ДатаРожденияПриИзменении(Элемент)
	Если Год(ТекущаяДата()) - Год(Объект.ДатаРождения) > 85 Тогда
		Элементы.ВетеранВОВ.Видимость = Истина;
	Иначе	
		Элементы.ВетеранВОВ.Видимость = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьНаименование()
	Объект.Наименование = Объект.Фамилия + " " + Объект.Имя + ?(ПустаяСтрока(Объект.Отчество),""," " + Объект.Отчество);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьНаДубли(Ссылка,Фамилия,Имя,Отчество,ДатаРождения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Охотники.Ссылка
	|ИЗ
	|	Справочник.Охотники КАК Охотники
	|ГДЕ
	|	Охотники.Фамилия = &Фамилия
	|	И Охотники.Имя = &Имя
	|	И Охотники.Отчество = &Отчество
	|	И Охотники.ДатаРождения = &ДатаРождения
	|	И %УсловиеСсылки%";
	
	Если Ссылка.Пустая() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И %УсловиеСсылки%","");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И %УсловиеСсылки%","И Охотники.Ссылка <> &Ссылка");
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
	КонецЕсли;	
		
	
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("Отчество", Отчество);
	Запрос.УстановитьПараметр("Фамилия", Фамилия);
	Запрос.УстановитьПараметр("ДатаРождения", ДатаРождения);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Выборка = Результат.Выбрать();		
		
		Если Выборка.Следующий() Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции
#КонецОбласти


#Область ТабличныеЧасти
&НаКлиенте
Процедура ГосБилетыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ГосБилет = ПредопределенноеЗначение("Перечисление.ВидыОхотничьихБилетов.ГосБилет");
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ВидБилета",ГосБилет);
	ПараметрыОткрытия.Вставить("Добавление",Истина);
	
	
	
	Если  Объект.Ссылка.Пустая() Тогда
		Описание = Новый ОписаниеОповещения("БилетыНачалоДобавления",ЭтаФорма,ПараметрыОткрытия);
		ПоказатьВопрос(Описание,"Перед созданием билетов необходимо записать охотника в базу.
		|Записать охотника?",РежимДиалогаВопрос.ДаНет,60,КодВозвратаДиалога.Да);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Модифицированность Тогда
		Описание = Новый ОписаниеОповещения("БилетыНачалоДобавления",ЭтаФорма,ПараметрыОткрытия);
		ПоказатьВопрос(Описание,"Перед созданием билетов необходимо записать охотника в базу.
		|Записать охотника?",РежимДиалогаВопрос.ДаНет,60,КодВозвратаДиалога.Да);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ДанныеОхотника.Лишен Тогда
		Текст = "Охотник лишен права охоты.
		|Гос билет зарегистрировать невозможно";
		ПоказатьСообщениеНаСервере(Текст,"Объект");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ДанныеОхотника.ЕстьГосБилет Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У охотника уже есть действующий гос билет");
	Иначе	
		Если НЕ Копирование Тогда
			Отказ = Истина;
			ОткрытьФормуБилета(ПараметрыОткрытия);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

