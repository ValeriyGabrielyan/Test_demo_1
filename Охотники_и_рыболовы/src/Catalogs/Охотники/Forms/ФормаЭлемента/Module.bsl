&НаКлиенте
Процедура БилетыНачалоДобавления(РезультатВопроса,ПараметрыОткрытия) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	Если ЭтаФорма.Записать() Тогда
		ОткрытьФормуБилета(ПараметрыОткрытия);	
	Иначе
		Текст = "Не удалось записать объект";
		Поле = "Объект";
		ПоказатьСообщениеНаСервере(Текст,Поле);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуБилета(ПараметрыОткрытия)
	
	Если ПараметрыОткрытия.ВидБилета = ПредопределенноеЗначение("Перечисление.ВидыОхотничьихБилетов.ЧленскийБилет") Тогда 
		ГосБилет = ПредопределенноеЗначение("Перечисление.ВидыОхотничьихБилетов.ГосБилет");
		ПараметрыБилета = Новый Структура("Охотник,ВидБилета,Охотхозяйство",Объект.Ссылка,ГосБилет);
		Если НЕ ДанныеОхотника.ЕстьГосБилет Тогда
			
			Текст = "Нет действительного государственного билета.
			|Создание членского билета невозможно.";
			Поле = "ГосБилеты";
			ПоказатьСообщениеНаСервере(Текст,Поле);
			Объект.ЧленОООР = Ложь;
			Объект.Охотхозяйство = ПредопределенноеЗначение("Справочник.Охотники.ПустаяСсылка");
			ЭтаФорма.Записать();
			Возврат;
	
		КонецЕсли;
	КонецЕсли;
	
		
	
	Если ПараметрыОткрытия.Свойство("Ключ") И  ЗначениеЗаполнено(ПараметрыОткрытия.Ключ) Тогда
		ПараметрыФормы = Новый Структура("Ключ", ПараметрыОткрытия.Ключ);
	Иначе	
		ЗначенияЗаполнения = Новый Структура("Охотник,ВидБилета",Объект.Ссылка,ПараметрыОткрытия.ВидБилета);
		
		Если ПараметрыОткрытия.Свойство("Добавление") Тогда
			ЗначенияЗаполнения.Вставить("Действует",ПараметрыОткрытия.Добавление);
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	КонецЕсли;	
	
	Если ПараметрыФормы.Количество() > 0 Тогда
		ОткрытьФорму("РегистрСведений.ОхотничьиБилеты.ФормаЗаписи", ПараметрыФормы,ЭтаФорма,УникальныйИдентификатор);
	КонецЕсли;	
	
КонецПроцедуры	
#КонецОбласти


&НаСервереБезКонтекста
Процедура ПоказатьСообщениеНаСервере(Текст,Поле)
	ОхотаСервер.ПоказатьСообщение(Текст,Поле);	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ДанныеОхотника = Неопределено Тогда
		ДанныеОхотника = ОхотаСерверПовтИсп.ПолучитьДанныеОхотника(Объект.Ссылка);
	КонецЕсли;	
	

	Если ДанныеОхотника.ЕстьЧленскийБилет <> Объект.ЧленОООР Тогда
		Объект.ЧленОООР = ДанныеОхотника.ЕстьЧленскийБилет;
	КонецЕсли;	
	
	Если НЕ ДанныеОхотника.ЕстьЧленскийБилет Тогда
		Объект.ЧленОООР  = Ложь;
		Элементы.ЧленОООР.Заголовок = "Не является членом ОООР";
		Элементы.ЧленККОООР.Заголовок = "Не является членом ККОООР";
		Объект.Охотхозяйство = Неопределено; 
		
	ИначеЕсли   Объект.Охотхозяйство.ЧленствоККОООР = Истина Тогда
		Объект.ЧленККОООР  = Истина;
		Объект.ЧленОООР  = Истина;
		Элементы.ЧленККОООР.Заголовок = "Член ККОООР";
		
	Иначе
		Объект.ЧленОООР  = Истина;
		Элементы.ЧленОООР.Заголовок = "Член ОООР";
		Элементы.ЧленККОООР.Заголовок = "Не является членом ККОООР";

		Объект.Охотхозяйство = ДанныеОхотника.КемВыданЧленскийБилет;
		Элементы.ЧленОООР.Заголовок = "Является членом " + ПолучитьРеквизитСсылки(ДанныеОхотника.КемВыданЧленскийБилет,"Наименование");
	КонецЕсли;
	
	УстановитьПараметрыДинамическихСписков();
	ПолучитьРеквизитыАдреса();
КонецПроцедуры


&НаСервере
Процедура УстановитьПараметрыДинамическихСписков()
	ГосБилеты.Параметры.УстановитьЗначениеПараметра("Охотник",Объект.Ссылка);
	ЧленскиеБилеты.Параметры.УстановитьЗначениеПараметра("Охотник",Объект.Ссылка);
КонецПроцедуры

&НаСервере
Процедура ПолучитьРеквизитыАдреса(ЗаписатьНабор = Ложь)
	Если НЕ Объект.Ссылка.Пустая() Тогда
		Набор = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
		Набор.Отбор.Охотник.Установить(Объект.Ссылка);
		Набор.Прочитать();
		
		Если Набор.Количество() = 0 Тогда
			Если ЗаписатьНабор Тогда
				Запись = Набор.Добавить();
				ЗаполнитьЗначенияСвойств(Запись,ЭтотОбъект);
				Запись.Охотник = Объект.Ссылка;
				
				Набор.Записать(Истина);
			Иначе	
			     Возврат;
			КонецЕсли;	 
		Иначе
			Запись = Набор.Получить(0);
			
			Если ЗаписатьНабор Тогда
				
				ЗаполнитьЗначенияСвойств(Запись,ЭтотОбъект);
				Запись.Охотник = Объект.Ссылка;
				
				Набор.Записать(Истина);
			Иначе
				ЗаполнитьЗначенияСвойств(ЭтотОбъект,Запись);	
			КонецЕсли;	 
			
		КонецЕсли;	
	КонецЕсли;	
		
КонецПроцедуры



&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, ПараметрыОтвета, Источник)
	Если ИмяСобытия = "ИзменениеОхотничьегоБилета" Тогда
		
		Если ПараметрыОтвета.Билет = ПредопределенноеЗначение("Перечисление.ВидыОхотничьихБилетов.ЧленскийБилет") Тогда
			Если НЕ ПараметрыОтвета.Действует Тогда
				Объект.ЧленОООР  = Ложь;
				Объект.ЧленККОООР  = Ложь;
				Элементы.ЧленОООР.Заголовок = "Не является членом ОООР";
				Элементы.ЧленККОООР.Заголовок = "Не является членом ККОООР";
				Объект.Охотхозяйство = Неопределено; 
			Иначе
				Объект.ЧленОООР  = Истина;
				Элементы.ЧленОООР.Заголовок = "Член ОООР";
				Объект.Охотхозяйство = ПараметрыОтвета.ЗарегистрированВ;
				Элементы.ЧленОООР.Заголовок = "Является членом " + ПолучитьРеквизитСсылки(ПараметрыОтвета.ЗарегистрированВ,"Наименование");
				Объект.ЧленККОООР  = Истина;
				Элементы.ЧленККОООР.Заголовок = "Является членом ККОООР";
			КонецЕсли;
			Если ПараметрыОтвета.Исключен Тогда
				Объект.Исключен=Истина;
			КонецЕсли;
		ИначеЕсли ПараметрыОтвета.Билет = ПредопределенноеЗначение("Перечисление.ВидыОхотничьихБилетов.ГосБилет") Тогда
			Объект.СерияГосБилета = ?(ПараметрыОтвета.Действует,ПараметрыОтвета.Серия,"");
			Объект.НомерГосБилета = ?(ПараметрыОтвета.Действует,ПараметрыОтвета.Номер,"");
		КонецЕсли;
		
		Попытка
			ЭтаФорма.Записать();
			
			ДанныеОхотника = ОхотаСерверПовтИсп.ПолучитьДанныеОхотника(Объект.Ссылка);
			
			Если ГосБилеты.Параметры.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Охотник")).Значение.Пустая() Тогда
				УстановитьПараметрыДинамическихСписков();
			КонецЕсли;
				
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Возникли ошибки записи охотника");
		КонецПопытки;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОповеститьОбИзменении(Объект.Ссылка); //"ИзменениеДанныхОхотника"
	ПолучитьРеквизитыАдреса(Истина);
	КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ПроверитьНаДубли(Объект.Ссылка,Объект.Фамилия,Объект.Имя,Объект.Отчество,Объект.ДатаРождения) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("НаименованиеИзменениеЗавершение",ЭтаФорма);
		ТекстПредупреждения = "Такой пользователь существует.
		|Дублировать записи запрещено.";
		ПоказатьПредупреждение(ОписаниеОповещения,ТекстПредупреждения,5,"Проверка дублей охотников");
		Отказ = Истина;
		Возврат;	
	КонецЕсли;
	ПолучитьНаименование();
	 
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьРеквизитСсылки(Ссылка,Реквизит)
	Возврат Ссылка[Реквизит];
КонецФункции	

&НаКлиенте
Процедура Печать(Команда)
	ИмяМакета = Команда.Имя;
		
	ОткрытьФормуПечатиСправочники(ИмяМакета);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПечатиСправочники(ИмяМакета)
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ИмяМакета",ИмяМакета);
	ПараметрыПечати.Вставить("Справочник",Объект.Ссылка);
	ОткрытьФорму("ОбщаяФорма.ФормаПечатиСправочники",ПараметрыПечати,ЭтаФорма,УникальныйИдентификатор);
КонецПроцедуры




