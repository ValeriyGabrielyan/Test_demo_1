    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ОхотничьиБилеты.Серия,
	ОхотничьиБилеты.Номер,
	ОхотничьиБилеты.ДатаВыдачи,
	ОхотничьиБилеты.ЗарегистрированВ,
	ОхотничьиБилеты.Действует,
	ОхотничьиБилеты.Причина
ИЗ
	РегистрСведений.ОхотничьиБилеты КАК ОхотничьиБилеты
ГДЕ
	ОхотничьиБилеты.ВидБилета = ЗНАЧЕНИЕ(Перечисление.ВидыОхотничьихБилетов.ГосБилет)
	И ОхотничьиБилеты.Охотник = &amp;Охотник</queryText>
      <mainTable>InformationRegister.ОхотничьиБилеты</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
