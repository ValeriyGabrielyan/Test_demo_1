Функция ПолучитьСписокДичи(ВидДичи,Группа) Экспорт
	
	Запрос = Новый Запрос;
	Если Группа Тогда
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыДичиСостав.Ссылка КАК Дичь,
		|	ГруппыДичиСостав.Ссылка.Представление КАК Представление
		|ИЗ
		|	Справочник.ГруппыДичи.Состав КАК ГруппыДичиСостав
		|ГДЕ
		|	ГруппыДичиСостав.Ссылка.ВидДичи = &ВидДичи
		|	И НЕ ГруппыДичиСостав.Дичь.ПометкаУдаления
		|	И НЕ ГруппыДичиСостав.Ссылка.ПометкаУдаления";

	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДичьВидыДичи.Ссылка КАК Дичь,
		|	ДичьВидыДичи.Ссылка.Представление КАК Представление
		|ИЗ
		|	Справочник.Дичь.ВидыДичи КАК ДичьВидыДичи
		|ГДЕ
		|	ДичьВидыДичи.ВидДичи = &ВидДичи
		|	И НЕ ДичьВидыДичи.Ссылка.ПометкаУдаления";
	КонецЕсли;
	
	
	Запрос.УстановитьПараметр("ВидДичи", ВидДичи);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СписокДичи = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		СписокДичи.Добавить(Выборка.Дичь,Выборка.Представление);
	КонецЦикла;
	
	Возврат СписокДичи;	
КонецФункции

Функция ПолучитьПринтер() Экспорт
        
    Скрипт = Новый COMОбъект("MSScriptControl.ScriptControl");
    Скрипт.Language = "vbscript";                 
    Скрипт.AddCode("
         |Function GetDefaultPrinter()
         |GetDefaultPrinter=vbNullString
         |Set objWMIService=GetObject(""winmgmts:"" _
         |& ""{impersonationLevel=impersonate}!\\.\root\cimv2"")
         |Set colInstalledPrinters=objWMIService.ExecQuery _
         |(""Select * from Win32_Printer"")
         |For Each objPrinter in colInstalledPrinters
         |If objPrinter.Attributes and 4 Then
         |GetDefaultPrinter=objPrinter.Name
         |Exit For
         |End If
         |Next
         |End Function");
         
    Возврат СокрЛП(Скрипт.run("GetDefaultPrinter"));
    
КонецФункции

