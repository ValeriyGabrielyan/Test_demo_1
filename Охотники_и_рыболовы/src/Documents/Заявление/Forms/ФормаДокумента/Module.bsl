&НаСервереБезКонтекста
Функция ПроверитьКорректностьПодбора(Разрешение,Заявление)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(РазрешениеНаОхоту.Ссылка) КАК Разрешение
		|ИЗ
		|	Документ.РазрешениеНаОхоту КАК РазрешениеНаОхоту
		|ГДЕ
		|	РазрешениеНаОхоту.Ссылка = &Разрешение
		|	И РазрешениеНаОхоту.Заявление <> &Заявление
		|	И РазрешениеНаОхоту.Проведен";
	
	Запрос.УстановитьПараметр("Заявление", Заявление);
	Запрос.УстановитьПараметр("Разрешение", Разрешение);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий(); 
	
	Разрешение = Выборка.Разрешение;
	
	Возврат Ложь;
	
КонецФункции	



