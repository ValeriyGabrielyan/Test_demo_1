
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийСезон = ОхотаСерверПовтИсп.ПолучитьТекущийСезон();
	
	Если ТекущийСезон.Пустая() Тогда
		ТекстСообщения = "Сезон охоты не открыт";
		Поле = "Объект.СезонОхоты";
		ОхотаСервер.ПоказатьСообщение(ТекстСообщения,Поле);
		Отказ = Истина;
		Возврат;
	Иначе
		Если Объект.СезонОхоты.Пустая() Тогда 
			Объект.СезонОхоты = ТекущийСезон;
		КонецЕсли;
		Элементы.СезонОхоты.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ДокументОснование = Объект.ДокументОснование;
	БезПроверки = ДокументОснование.БезПроверки;
	
	ОснОтветственный = ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ОсновнойОтветственный");
	
	Если Объект.Ответственный.Пустая() Тогда
		Объект.Ответственный = ОхотаСерверПовтИсп.ПолучитьНастройкуПользователя(ОснОтветственный);	
	КонецЕсли;	
	
	Если РольДоступна("ПолныеПрава") Тогда
		Элементы.Охотхозяйство.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Объект.Руководитель = Объект.Охотхозяйство.ФИОРуководителя;
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Сезонная = ДокументОснование.Сезонная;
		ОснОрганизация = ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ОсновнаяОрганизация");
		
		Охотхозяйство = ОхотаСерверПовтИсп.ПолучитьНастройкуПользователя(ОснОрганизация);
		Если Объект.Охотхозяйство.Пустая() Тогда
			Объект.Охотхозяйство = Охотхозяйство;
		КонецЕсли;	
		
		Если Объект.МестоОхоты.Пустая() Тогда
			Объект.МестоОхоты = Охотхозяйство;
		КонецЕсли;	
	Иначе	
		
		ПолучитьПериодыОхоты(Истина);
	КонецЕсли;

	
		
	ПараметрыВыбораПоСубъекту = ОхотаСерверПовтИсп.ПолучитьПараметрыВыбораПоСубъектуРФ();
	Элементы.МестоОхоты.ПараметрыВыбора = ПараметрыВыбораПоСубъекту;
	Элементы.Охотхозяйство.ПараметрыВыбора = ПараметрыВыбораПоСубъекту;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
		
	Если Объект.Охотхозяйство.Пустая() ИЛИ Объект.МестоОхоты.Пустая() ИЛИ
		Объект.Охотник.Пустая() ИЛИ Объект.ВидДичи.Пустая() Тогда
		Элементы.ПериодОхоты.ТолькоПросмотр = Истина;
		Элементы.ДатаНачала.ТолькоПросмотр = Истина;
		Элементы.ДатаОкончания.ТолькоПросмотр = Истина;
	Иначе
		Элементы.ПериодОхоты.ТолькоПросмотр = Ложь;
		Элементы.ДатаНачала.ТолькоПросмотр = Ложь;
		Элементы.ДатаОкончания.ТолькоПросмотр = Ложь;
	КонецЕсли;	
	
	Если Объект.ДокументОснование.Пустая() Тогда
		Элементы.Группа1.ТолькоПросмотр =Ложь;
		Элементы.Группа3.ТолькоПросмотр =Ложь;
		
	Иначе
		Элементы.Группа1.ТолькоПросмотр = Истина;
		Элементы.Группа3.ТолькоПросмотр = Истина;
		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	ИмяМакета = Команда.Имя;
	  Если Не ПроверитьВозможностьПечати(ИмяМакета) Тогда
		Возврат;
	КонецЕсли;

		
	ОткрытьФормуПечати(ИмяМакета);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьВозможностьПечати(ИмяМакета)
		
	Если НЕ Объект.Проведен Тогда
		Описание = Новый ОписаниеОповещения("ПроверкаВозможностиПечатиЗавершение",ЭтаФорма,ИмяМакета);
		ПоказатьВопрос(Описание,"Документ не проведен.Для печати его необходимо провести.
		|Провести документ?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		
		Возврат Ложь;					
	КонецЕсли;
	
	Если Модифицированность Тогда
		Описание = Новый ОписаниеОповещения("ПроверкаВозможностиПечатиЗавершение",ЭтаФорма,ИмяМакета);
		ПоказатьВопрос(Описание,"Документ изменен. Для печати его необходимо провести.
		|Провести документ?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		
		Возврат Ложь;					
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции
&НаКлиенте
Процедура ПроверкаВозможностиПечатиЗавершение(РезультатВопроса,ИмяМакета) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Объект.ДокументОснование.Пустая() И НЕ ПроведенДокументОснование() Тогда
		//Надо провести разрешение, а потом путевку
		Описание = Новый ОписаниеОповещения("ДокументОснованиеПроведение",ЭтаФорма,ИмяМакета);
		ПоказатьВопрос(Описание,"Необходимо сначала провести документ основание",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		Возврат;
	КонецЕсли;	
	
	Отказ = Ложь;
	Попытка
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи",РежимЗаписиДокумента.Проведение);
		Если НЕ ЭтаФорма.Записать(ПараметрыЗаписи) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ИнформацияОбОшибке().Описание);		
			Отказ  = Истина;		
		КонецЕсли;
		
		
	Исключение
		Отказ = Истина;
		Текст = ОписаниеОшибки(); 
		Поле = "Объект";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст,Поле);
		
	КонецПопытки;
	
	Если НЕ Отказ Тогда
		ОткрытьФормуПечати(ИмяМакета);
	КонецЕсли;	
	
КонецПроцедуры	


&НаКлиенте
Процедура ОткрытьФормуПечати(ИмяМакета)
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ИмяМакета",ИмяМакета);
	ПараметрыПечати.Вставить("Документ",Объект.Ссылка);
	ОткрытьФорму("ОбщаяФорма.ФормаПечати",ПараметрыПечати,ЭтаФорма,УникальныйИдентификатор);
КонецПроцедуры


&НаСервере
Функция ПроведенДокументОснование()
	Возврат Объект.ДокументОснование.Проведен;	
КонецФункции


&НаКлиенте
Процедура ДокументОснованиеПроведение(РезультатВопроса,ИмяМакета) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗаписатьДокументОснование() Тогда
		Возврат;
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьДокументОснование()
	
	ДокументОснование = Объект.ДокументОснование.ПолучитьОбъект();
	Попытка
		ДокументОснование.Записать();
		
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
		
	Если НЕ Объект.ДокументОснование.Пустая() И ПолучитьРеквизитДокумента(Объект.ДокументОснование,"Заявление").Пустая() Тогда
		УстановитьРеквизитВРазрешении();	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УстановитьРеквизитВРазрешении();	
	ДокРазрешение = Объект.ДокументОснование.ПолучитьОбъект();
	ДокРазрешение.Заявление = Объект.Ссылка;
	Попытка
		ДокРазрешение.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
	КонецПопытки;
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьРеквизитДокумента(СсылкаДокумента,ИмяРеквизита)
	Возврат СсылкаДокумента[ИмяРеквизита];	
КонецФункции	


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПроизвольныйПериодПриИзменении(Неопределено);
	Если НЕ ВладелецФормы = Неопределено И ТипЗнч(ВладелецФормы) = Тип("УправляемаяФорма") Тогда
		Элементы.ГруппаСезоннаяРазоваяПроизвольный.Видимость = ВладелецФормы.Элементы.ГруппаСезоннаяРазоваяПроизвольный.Видимость;
	КонецЕсли;	
	
	УстановитьДоступностьЭлементов();

	Если НЕ ЗначениеЗаполнено(Объект.ВидДичи) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ПериодОхоты = ("с " + Формат(Объект.ДатаНачала, "ДФ ='дд.ММ.гггг'") + " по " +  Формат(Объект.ДатаОкончания, "ДФ ='дд.ММ.гггг'"));
		Элементы.ПериодОхоты.СписокВыбора.Добавить(ПериодОхоты,ПериодОхоты);
	КонецЕсли;
	
	
	
КонецПроцедуры



&НаКлиенте
Процедура ОхотникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОхотникАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	Если СтрДлина(Текст) < 2 Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;	
КонецПроцедуры



&НаКлиенте
Процедура НаименованиеДокументаОснованияНажатие(Элемент)
	
	Если Объект.ДокументОснование.Пустая() Тогда
		ОткрытьФорму("Документ.РазрешениеНаОхоту.Форма.ФормаВыбора",,ЭтаФорма,УникальныйИдентификатор);
	Иначе
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Ключ",Объект.ДокументОснование);
		Если ВладелецФормы = Неопределено ИЛИ ТипЗнч(ВладелецФормы) = Тип("ТаблицаФормы") Тогда
			ИдентификаторФормы = УникальныйИдентификатор;
			ОткрытьФорму("Документ.РазрешениеНаОхоту.Форма.ФормаДокумента",ПараметрыОткрытия,ЭтаФорма, ИдентификаторФормы);	
		Иначе
			Если ВладелецФормы.Объект.Ссылка = Объект.ДокументОснование Тогда
				ВладелецФормы.Активизировать();
			Иначе
				ОткрытьФорму("Документ.РазрешениеНаОхоту.Форма.ФормаДокумента",ПараметрыОткрытия,ЭтаФорма, ИдентификаторФормы);	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры



&НаСервереБезКонтекста
Процедура ПоказатьСообщениеНаСервере(Текст,Поле)
	ОхотаСервер.ПоказатьСообщение(Текст,Поле);	
КонецПроцедуры

&НаКлиенте
Процедура ВидДичиПриИзменении(Элемент)
	УстановитьДоступностьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ВидДичиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если НЕ Объект.ВидДичи.Пустая() Тогда
		ПредыдущийВидДичи = Объект.ВидДичи;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.МестоОхоты) Тогда
		Текст = "Необходимо заполнить место охоты";
		Поле = "Объект.МестоОхоты";
		ПоказатьСообщениеНаСервере(Текст,Поле);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокДичи(ВидДичи)
	
	Если ВидДичи.Пустая() Тогда
		Возврат Новый СписокЗначений;
	Иначе
		Возврат ОхотаСерверПовтИсп.ПолучитьСписокДичи(ВидДичи,Ложь);	
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура ПроизвольныйПериодПриИзменении(Элемент)
	Элементы.ГруппаПроизвольныйПериод.Видимость = Объект.ПроизвольныйПериод;
	Элементы.ПериодОхоты.Видимость = НЕ Объект.ПроизвольныйПериод;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодОхотыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Объект.ВидДичи.Пустая() Тогда
		Текст = "Не заполнен вид дичи.
		|Невозможно подобрать актуальные периоды охоты!";
		Поле = "Объект.ВидДичи";
		ПоказатьСообщениеНаСервере(Текст,Поле);
		Возврат;
	КонецЕсли;	
	
	ПодобратьПериодыОхоты();
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодОхотыПриИзменении(Элемент)
	ТекстДатаНачала = Сред(ПериодОхоты,3,10);
	ТекстДатаОкончания = Прав(ПериодОхоты,10);
	
	ДатаНачала = Дата(Прав(ТекстДатаНачала,4) + Сред(ТекстДатаНачала,4,2) + Лев(ТекстДатаНачала,2));
	ДатаОкончания = Дата(Прав(ТекстДатаОкончания,4) + Сред(ТекстДатаОкончания,4,2) + Лев(ТекстДатаОкончания,2));
	
	Объект.ДатаНачала = ДатаНачала;
	Объект.ДатаОкончания = ДатаОкончания;
	
		
КонецПроцедуры

&НаСервере
Процедура ПолучитьПериодыОхоты(ПриСоздании = Ложь)
	мПериоды = ОхотаСервер.ПолучитьПериодыОхоты(Объект); 
	Если мПериоды.Пустой() И НЕ ПриСоздании Тогда
		Текст = "Не определены периоды охоты";
		Поле = "Объект";
		ОхотаСервер.ПоказатьСообщение(Текст,Поле);
		Возврат;
	Иначе
		Периоды = мПериоды.Выгрузить();
		СтруктураОтбора = Новый Структура("ВидДичи",Объект.ВидДичи);
		Строки = Периоды.НайтиСтроки(СтруктураОтбора);
		Если Строки.Количество() = 0 И НЕ ПриСоздании Тогда
			Текст = "Не определены периоды охоты";
			Поле = "Объект.ВидДичи";
			ОхотаСервер.ПоказатьСообщение(Текст,Поле);
			Возврат;
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ ПриСоздании Тогда
		ТолькоСезонная = Истина;
		Для каждого стр из Периоды Цикл
			ТолькоСезонная = ТолькоСезонная И стр.ТолькоСезонная;
		КонецЦикла;		
		
		Элементы.ГруппаСезоннаяРазоваяПроизвольный.Видимость = НЕ ТолькоСезонная;
		Объект.Сезонная = ?(ТолькоСезонная,Истина,Объект.Сезонная);
		Объект.ПроизвольныйПериод = ?(ТолькоСезонная,Ложь,Объект.ПроизвольныйПериод);
	КонецЕсли;	
	
	ЗначениеВРеквизитФормы(Периоды,"ПериодыОхоты");
	
	
КонецПроцедуры
&НаСервере
Процедура ПодобратьПериодыОхоты()
	
	Периоды = РеквизитФормыВЗначение("ПериодыОхоты");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВрТаб.ВидДичи,
	|	ВрТаб.ДатаНачала,
	|	ВрТаб.ДатаОкончания,
	|	ВрТаб.РазоваяДатаНачала,
	|	ВрТаб.РазоваяДатаОкончания,
	|	&Сезонная
	|ПОМЕСТИТЬ Периоды
	|ИЗ
	|	&ВрТаб КАК ВрТаб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Периоды.ВидДичи,
	|	ВЫБОР
	|		КОГДА Периоды.Сезонная
	|			ТОГДА Периоды.ДатаНачала
	|		ИНАЧЕ Периоды.РазоваяДатаНачала
	|	КОНЕЦ КАК ДатаНачала,
	|	ВЫБОР
	|		КОГДА Периоды.Сезонная
	|			ТОГДА Периоды.ДатаОкончания
	|		ИНАЧЕ Периоды.РазоваяДатаОкончания
	|	КОНЕЦ КАК ДатаОкончания
	|ИЗ
	|	Периоды КАК Периоды
	|ГДЕ
	|	Периоды.ВидДичи = &ВидДичи
	|	И ВЫБОР
	|			КОГДА Периоды.Сезонная
	|				ТОГДА НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) <= КОНЕЦПЕРИОДА(Периоды.ДатаОкончания, ДЕНЬ)
	|			ИНАЧЕ НАЧАЛОПЕРИОДА(Периоды.РазоваяДатаНачала, ДЕНЬ) >= НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
	|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ВидДичи", Объект.ВидДичи);
	Запрос.УстановитьПараметр("ВрТаб",Периоды);
	Запрос.УстановитьПараметр("Сезонная",Объект.Сезонная);
	Запрос.УстановитьПараметр("Дата",?(Объект.Дата = '00010101',ТекущаяДата(),Объект.Дата));
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Если Периоды.Количество() = 0 Тогда
			Текст = "Для данного вида дичи не определены периоды охоты";
			Поле = "Объект.ВидДичи";
			ПоказатьСообщениеНаСервере(Текст,Поле);
			Возврат;
		Иначе
			Если Периоды.Найти(NULL,"РазоваяДатаНачала") <> Неопределено Тогда
				Текст = "Не заполнен производственный календарь на период охоты";
				Поле = "Объект";
				ПоказатьСообщениеНаСервере(Текст,Поле);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Выборка =  Результат.Выбрать();
	
	МассивПериодов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивПериодов.Добавить("с " + Формат(Выборка.ДатаНачала, "ДФ ='дд.ММ.гггг '") + " по " +  Формат(Выборка.ДатаОкончания, "ДФ ='дд.ММ.гггг'"));
	КонецЦикла;	
	
	Элементы.ПериодОхоты.СписокВыбора.ЗагрузитьЗначения(МассивПериодов);		
	
	Если ПериодОхоты = "" Тогда
		ПериодОхоты = ("с " + Формат(Объект.ДатаНачала, "ДФ ='дд.ММ.гггг '") + " по " +  Формат(Объект.ДатаОкончания, "ДФ ='дд.ММ.гггг'"));
	КонецЕсли;	
	//Элементы.ПериодОхоты.СписокВыбора.ЗагрузитьЗначения(мПериоды.ВыгрузитьКолонку("Имя"));
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	Если Объект.ДатаОкончания = '00010101' Тогда
		Возврат;
	КонецЕсли;	
	ОшибкиПериода = ПолучитьПроизвольныеПериодыОхоты(Объект.ВидДичи,Объект.СезонОхоты,Объект.ДатаНачала,Объект.ДатаОкончания,Объект.Дата,Элемент.Имя);
	Если ОшибкиПериода.Отказ Тогда
		Объект.ДатаНачала = '00010101';
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОшибкиПериода.ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	Если Объект.ДатаНачала = '00010101' Тогда
		Возврат;
	КонецЕсли;
	ОшибкиПериода = ПолучитьПроизвольныеПериодыОхоты(Объект.ВидДичи,Объект.СезонОхоты,Объект.ДатаНачала,Объект.ДатаОкончания,Объект.Дата,Элемент.Имя);
	Если ОшибкиПериода.Отказ Тогда
		Объект.ДатаОкончания = '00010101';
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОшибкиПериода.ТекстОшибки);		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПроизвольныеПериодыОхоты(ВидДичи,СезонОхоты,ДатаНачала,ДатаОкончания,ДатаСреза,Элемент)
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Отказ",Ложь);
	
	Если ВидДичи.Пустая() Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки","Не заполнен вид дичи");
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МИНИМУМ(ЦеныПоВидамДичи.ДатаНачала) КАК ДатаНачала,
	|	МАКСИМУМ(ЦеныПоВидамДичи.ДатаОкончания) КАК ДатаОкончания
	|ИЗ
	|	РегистрСведений.ЦеныПоВидамДичи.СрезПоследних(
	|			&ДатаСреза,
	|			ВидДичи = &ВидДичи
	|				И СезонОхоты = &СезонОхоты) КАК ЦеныПоВидамДичи
	|
	|ИМЕЮЩИЕ
	|	НЕ МИНИМУМ(ЦеныПоВидамДичи.ДатаНачала) ЕСТЬ NULL  И
	|	НЕ МАКСИМУМ(ЦеныПоВидамДичи.ДатаОкончания) ЕСТЬ NULL ";
	
	Запрос.УстановитьПараметр("ВидДичи", ВидДичи);
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	Запрос.УстановитьПараметр("СезонОхоты", СезонОхоты);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки","Не определены периоды охоты");
		ДатаНачала = '00010101';
		ДатаОкончания = '00010101';
		Возврат СтруктураОтвета;
	КонецЕсли;	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();	
	
	Если ДатаНачала <> '00010101' И ДатаНачала < Выборка.ДатаНачала Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки",("Дата начала периода охоты не может быть ранее " + Формат(Выборка.ДатаНачала,"ДФ=dd.MM.yyyy")));
		ДатаНачала = Выборка.ДатаНачала;
		Возврат СтруктураОтвета;
	ИначеЕсли ДатаНачала > Выборка.ДатаОкончания Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки",("Дата начала периода охоты не может быть позже " + Формат(Выборка.ДатаОкончания,"ДФ=dd.MM.yyyy")));
		ДатаНачала = Выборка.ДатаНачала;
		Возврат СтруктураОтвета;
	ИначеЕсли ДатаОкончания <> '00010101' И ДатаОкончания < Выборка.ДатаНачала Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки",("Дата окончания периода охоты не может быть ранее " + Формат(Выборка.ДатаНачала,"ДФ=dd.MM.yyyy")));
		ДатаОкончания = Выборка.ДатаОкончания;
		Возврат СтруктураОтвета;
	ИначеЕсли ДатаОкончания > Выборка.ДатаОкончания Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки",("Дата окончания периода охоты не может быть позже " + Формат(Выборка.ДатаОкончания,"ДФ=dd.MM.yyyy")));
		ДатаОкончания = Выборка.ДатаОкончания;
		Возврат СтруктураОтвета;
	ИначеЕсли ДатаНачала > ДатаОкончания И ДатаОкончания <> '00010101' Тогда
		Если Элемент = "ДатаНачала" Тогда
			СтруктураОтвета.Вставить("Отказ",Истина);
			СтруктураОтвета.Вставить("ТекстОшибки","Дата начала периода охоты не может быть позже даты окончания");
			ДатаНачала = '00010101';
			Возврат СтруктураОтвета;
		ИначеЕсли Элемент = "ДатаОкончания" Тогда
			СтруктураОтвета.Вставить("Отказ",Истина);
			СтруктураОтвета.Вставить("ТекстОшибки","Дата окончания периода охоты не может быть раньше даты начала");
			ДатаОкончания = '00010101';
			Возврат СтруктураОтвета;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
	
КонецФункции	

