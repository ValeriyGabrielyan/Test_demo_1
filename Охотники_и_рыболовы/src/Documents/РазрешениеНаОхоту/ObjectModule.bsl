Процедура ПередУдалением(Отказ)
	
	Путевка = ОхотаСервер.НайтиПодчиненнуюПутевку(Ссылка);
	Если НЕ Путевка.Пустая() Тогда	
		Попытка
			ПутевкаОбъект = Путевка.ПолучитьОбъект();
			ПутевкаОбъект.Удалить();
		Исключение
			Отказ = Истина;
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.СформироватьТекстСообщения(ОписаниеОшибки());
			ЗаписьЖурналаРегистрации("Данные.Удаление",УровеньЖурналаРегистрации.Ошибка,ЭтотОбъект.Метаданные(),ЭтотОбъект.Ссылка,ТекстОшибки);
		КонецПопытки;
	КонецЕсли;	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если НЕ БезПроверки Тогда
		ПроверяемыеРеквизиты.Добавить("СезонОхоты");
		ПроверяемыеРеквизиты.Добавить("Охотхозяйство");
		ПроверяемыеРеквизиты.Добавить("МестоОхоты");
		ПроверяемыеРеквизиты.Добавить("ВидДичи");
		ПроверяемыеРеквизиты.Добавить("Охотник");
		ПроверяемыеРеквизиты.Добавить("ДатаНачала");
		ПроверяемыеРеквизиты.Добавить("ДатаОкончания");
		ПроверяемыеРеквизиты.Добавить("СерияРазрешения");
		ПроверяемыеРеквизиты.Добавить("НомерРазрешения");
		ПроверяемыеРеквизиты.Добавить("Ответственный");
	Иначе
		СтруктураДанных = Константы.ОбязательныеРеквизитыРазрешенияДляЕгеря.Получить().Получить();
		Для каждого КлючИЗначение из СтруктураДанных Цикл
			Если КлючИЗначение.Значение Тогда
				ПроверяемыеРеквизиты.Добавить(КлючИЗначение.Ключ);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
		
КонецПроцедуры


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если НЕ Ссылка.Пустая() И ПутевкаДоговор.Пустая() Тогда
		ПутевкаДоговор = ОхотаСервер.НайтиПодчиненнуюПутевку(Ссылка);
	КонецЕсли;	
КонецПроцедуры

