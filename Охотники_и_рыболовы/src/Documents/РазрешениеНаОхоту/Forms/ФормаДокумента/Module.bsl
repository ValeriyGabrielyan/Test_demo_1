&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
Если Объект.АктМПР и Объект.Сдан тогда
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при записи. Флажки АктМПР и Сдан установлены одновременно. ");
	Отказ= Истина;
КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДату(Команда)
	Стр = Элементы.ДобытаяДичь.ТекущиеДанные;
	Если НЕ ЗначениеЗаполнено(Стр.ДатаДобычи) тогда
		Для каждого Стр из Объект.ДобытаяДичь Цикл
			Стр.ДатаДобычи= ТекущаяДата();
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявлениеНажатие(Элемент)
	Заявление = Объект.Заявление;
	
	Если (Объект.ПометкаУдаления) И Не ЗначениеЗаполнено(Заявление) Тогда
		ПоказатьПредупреждение(,"Путевку нельзя вводить на основании документа, помеченного на удаление",60);
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуЗаявление(Заявление);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаявление(Заявление)
	
	Если НЕ Объект.Проведен ИЛИ Модифицированность Тогда
		ПроверкаПроведенияИМодифицированности(Заявление);
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Заявление) Тогда
		ПараметрыФормы = Новый Структура("Ключ",Заявление);
	Иначе
		ПараметрыФормы = Новый Структура("Основание",Объект.Ссылка);
	КонецЕсли;
	
	Если  ТипЗнч(ВладелецФормы) = Тип("УправляемаяФорма") Тогда
		Если СтрНайти(ВладелецФормы.ИмяФормы,"Документ.Заявление") <> 0 Тогда
			Если ВладелецФормы.Объект.Ссылка = Заявление Тогда
				ВладелецФормы.Активизировать();
			КонецЕсли;	
		Иначе
			ОткрытьФорму("Документ.Заявление.ФормаОбъекта", ПараметрыФормы,ЭтаФорма,УникальныйИдентификатор);	
		КонецЕсли;	
	Иначе
		ОткрытьФорму("Документ.Заявление.ФормаОбъекта", ПараметрыФормы,ЭтаФорма,УникальныйИдентификатор);
	КонецЕсли;
	
	
КонецПроцедуры


