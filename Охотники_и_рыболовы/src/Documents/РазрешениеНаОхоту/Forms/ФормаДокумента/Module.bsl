
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.ЗначениеКопирования.Пустая() Тогда
	
		
		
		ТекущийСезон = ОхотаСерверПовтИсп.ПолучитьТекущийСезон();
		
		Если ТекущийСезон.Пустая() Тогда
			ТекстСообщения = "Сезон охоты не открыт";
			Поле = "Объект.СезонОхоты";
			ОхотаСервер.ПоказатьСообщение(ТекстСообщения,Поле);
			Отказ = Истина;
			Возврат;
		ИначеЕсли Объект.СезонОхоты.Пустая() Тогда
			Объект.СезонОхоты = ТекущийСезон;
		КонецЕсли;
		
		ОснОтветственный = ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ОсновнойОтветственный");
		
		Если Объект.Ответственный.Пустая() Тогда
			Объект.Ответственный = ОхотаСерверПовтИсп.ПолучитьНастройкуПользователя(ОснОтветственный);	
		КонецЕсли;	
		
		Если РольДоступна("ПолныеПрава") Тогда
			Элементы.Охотхозяйство.ТолькоПросмотр = Ложь;
		КонецЕсли;
		
		
		Если Объект.Ссылка.Пустая() Тогда
			Объект.Сезонная = Истина;
			ОснОрганизация = ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ОсновнаяОрганизация");
			Объект.Охотхозяйство = ОхотаСерверПовтИсп.ПолучитьНастройкуПользователя(ОснОрганизация);
			Объект.МестоОхоты = Объект.Охотхозяйство;
		Иначе
			Если Объект.ПутевкаДоговор.Пустая() Тогда
				Путевка = ОхотаСервер.НайтиПодчиненнуюПутевку(Объект.Ссылка);
			 	Если НЕ Путевка.Пустая() Тогда
					Объект.ПутевкаДоговор = Путевка;
					Попытка
						Записать();
					Исключение
						Отказ = Истина;
					КонецПопытки;	
				КонецЕсли;                                    
			КонецЕсли;	
			СписокДичи = ПолучитьСписокДичи(Объект.ВидДичи);
		КонецЕсли;
	
	Иначе
		Объект.Обработан = Ложь;
		Объект.СерияРазрешения = "";
		Объект.НомерРазрешения = "";
		Объект.ПутевкаДоговор = Документы.ПутевкаДоговор.ПустаяСсылка();
	КонецЕсли;	
	
	ПолучитьПериодыОхоты(Истина);
	
	РаспечатанаЛицеваяСторона = Объект.Обработан;
	РаспечатанаОбратнаяСторона = Объект.Обработан;
	
	ПараметрыВыбораПоСубъектуРФ = ОхотаСерверПовтИсп.ПолучитьПараметрыВыбораПоСубъектуРФ ();
	Элементы.МестоОхоты.ПараметрыВыбора = ПараметрыВыбораПоСубъектуРФ;                                         
	Элементы.Охотхозяйство.ПараметрыВыбора = ПараметрыВыбораПоСубъектуРФ;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПутевку(Ссылка)
	Возврат ОхотаСервер.НайтиПодчиненнуюПутевку(Ссылка);	
КонецФункции

&НаКлиенте
Процедура Декорация1Нажатие(Элемент)
	
	Путевка = Объект.ПутевкаДоговор;
	
	Если (Объект.ПометкаУдаления) И Не ЗначениеЗаполнено(Путевка) Тогда
		ПоказатьПредупреждение(,"Путевку нельзя вводить на основании документа, помеченного на удаление",60);
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуПутевки(Путевка);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросНаФорме(ТекстВопроса,Путевка) Экспорт
	Оповещение = Новый ОписаниеОповещения("ПроверкаПроведенияЗавершение",ЭтаФорма,Путевка);					
	ПоказатьВопрос(Оповещение,ТекстВопроса,РежимДиалогаВопрос.ДаНет,60);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПутевки(Путевка)
	
	Если НЕ Объект.Проведен ИЛИ Модифицированность Тогда
		ПроверкаПроведенияИМодифицированности(Путевка);
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Путевка) Тогда
		ПараметрыФормы = Новый Структура("Ключ",Путевка);
	Иначе
		ПараметрыФормы = Новый Структура("Основание",Объект.Ссылка);
	КонецЕсли;
	
	Если  ТипЗнч(ВладелецФормы) = Тип("УправляемаяФорма") Тогда
		Если СтрНайти(ВладелецФормы.ИмяФормы,"Документ.ПутевкаДоговор") <> 0 Тогда
			Если ВладелецФормы.Объект.Ссылка = Путевка Тогда
				ВладелецФормы.Активизировать();
			КонецЕсли;	
		Иначе
			ОткрытьФорму("Документ.ПутевкаДоговор.ФормаОбъекта", ПараметрыФормы,ЭтаФорма,УникальныйИдентификатор);	
		КонецЕсли;	
	Иначе
		ОткрытьФорму("Документ.ПутевкаДоговор.ФормаОбъекта", ПараметрыФормы,ЭтаФорма,УникальныйИдентификатор);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаПроведенияЗавершение(РезультатВопроса,Путевка) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;						
	КонецЕсли;						
	
	Попытка
		ПараметрыЗаписи = Новый Структура("РежимЗаписи,Путевка",РежимЗаписиДокумента.Проведение,Путевка);
		ЭтаФорма.Записать(ПараметрыЗаписи);
	Исключение
		Текст = "Документ не удалось провести."; 
		СообщитьОбОшибкеНаСервере(Текст);
		Возврат;
	КонецПопытки;
	
	Путевка = ПараметрыЗаписи.Путевка;
	
	Если НЕ Путевка.Пустая() Тогда
		ОбновитьДанныеВПодчиненномДокументе(,Путевка);
	КонецЕсли;
	
	ОткрытьФормуПутевки(Путевка);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СообщитьОбОшибкеНаСервере(Текст)
	ОбщегоНазначения.СообщитьОбОшибке(Текст,,,СтатусСообщения.Важное);	
КонецПроцедуры


&НаСервере
Процедура ПолучитьПериодыОхоты(ПриСоздании = Ложь)
	мПериоды = ОхотаСервер.ПолучитьПериодыОхоты(Объект); 
	Если мПериоды.Пустой() И НЕ ПриСоздании Тогда
		Текст = "Не определены периоды охоты";
		Поле = "Объект";
		ОхотаСервер.ПоказатьСообщение(Текст,Поле);
		Возврат;
	Иначе
		Периоды = мПериоды.Выгрузить();
		СтруктураОтбора = Новый Структура("ВидДичи",Объект.ВидДичи);
		Строки = Периоды.НайтиСтроки(СтруктураОтбора);
		Если Строки.Количество() = 0 И НЕ ПриСоздании Тогда
			Текст = "Не определены периоды охоты";
			Поле = "Объект.ВидДичи";
			ОхотаСервер.ПоказатьСообщение(Текст,Поле);
			Возврат;
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ ПриСоздании Тогда
		ТолькоСезонная = Истина;
		Для каждого стр из Периоды Цикл
			ТолькоСезонная = ТолькоСезонная И стр.ТолькоСезонная;
		КонецЦикла;		
		
		Элементы.ГруппаСезоннаяРазоваяПроизвольный.Видимость = НЕ ТолькоСезонная;
		Объект.Сезонная = ?(ТолькоСезонная,Истина,Объект.Сезонная);
		Объект.ПроизвольныйПериод = ?(ТолькоСезонная,Ложь,Объект.ПроизвольныйПериод);
	КонецЕсли;	
	
	ЗначениеВРеквизитФормы(Периоды,"ПериодыОхоты");
	
КонецПроцедуры

&НаСервере
Процедура ПодобратьПериодыОхоты()
	
	Периоды = РеквизитФормыВЗначение("ПериодыОхоты");
	
	Если Периоды.Количество() = 0 Тогда
		Текст = "Для данного вида дичи не определены периоды охоты";
		Поле = "Объект.ВидДичи";
		ПоказатьСообщениеНаСервере(Текст,Поле);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВрТаб.ВидДичи,
	|	ВрТаб.ДатаНачала,
	|	ВрТаб.ДатаОкончания,
	|	ВрТаб.ТолькоСезонная,
	|	ВрТаб.РазоваяДатаНачала,
	|	ВрТаб.РазоваяДатаОкончания,
	|	&Сезонная
	|ПОМЕСТИТЬ Периоды
	|ИЗ
	|	&ВрТаб КАК ВрТаб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Периоды.ВидДичи,
	|	ВЫБОР
	|		КОГДА Периоды.Сезонная
	|			ТОГДА Периоды.ДатаНачала
	|		ИНАЧЕ Периоды.РазоваяДатаНачала
	|	КОНЕЦ КАК ДатаНачала,
	|	ВЫБОР
	|		КОГДА Периоды.Сезонная
	|			ТОГДА Периоды.ДатаОкончания
	|		ИНАЧЕ Периоды.РазоваяДатаОкончания
	|	КОНЕЦ КАК ДатаОкончания
	|ИЗ
	|	Периоды КАК Периоды
	|ГДЕ
	|	ВЫБОР
	|			КОГДА Периоды.Сезонная
	|				ТОГДА НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) <= КОНЕЦПЕРИОДА(Периоды.ДатаОкончания, ДЕНЬ)
	|			ИНАЧЕ НАЧАЛОПЕРИОДА(Периоды.РазоваяДатаНачала, ДЕНЬ) >= НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
	|		КОНЕЦ";
	
	
	Запрос.УстановитьПараметр("ВрТаб",Периоды);
	Запрос.УстановитьПараметр("Сезонная",Объект.Сезонная);
	Запрос.УстановитьПараметр("Дата",?(Объект.Дата = '00010101',ТекущаяДата(),Объект.Дата));
	Результат = Запрос.Выполнить();
	
	Выборка =  Результат.Выбрать();
	
	МассивПериодов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивПериодов.Добавить("с " + Формат(Выборка.ДатаНачала, "ДФ ='дд.ММ.гггг '") + " по " +  Формат(Выборка.ДатаОкончания, "ДФ ='дд.ММ.гггг'"));
	КонецЦикла;	
	
	Элементы.ПериодОхоты.СписокВыбора.ЗагрузитьЗначения(МассивПериодов);		
	
	Если ПериодыОхоты = "" Тогда
		ПериодыОхоты = ("с " + Формат(Объект.ДатаНачала, "ДФ ='дд.ММ.гггг '") + " по " +  Формат(Объект.ДатаОкончания, "ДФ ='дд.ММ.гггг'"));
	КонецЕсли;	
	//Элементы.ПериодОхоты.СписокВыбора.ЗагрузитьЗначения(мПериоды.ВыгрузитьКолонку("Имя"));
КонецПроцедуры

