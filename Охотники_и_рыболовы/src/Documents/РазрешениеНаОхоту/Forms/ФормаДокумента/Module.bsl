&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПроизвольныйПериодПриИзменении(Неопределено);

	Если НЕ ЗначениеЗаполнено(Объект.ВидДичи) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ПериодОхоты = ("с " + Формат(Объект.ДатаНачала, "ДФ ='дд.ММ.гггг'") + " по " +  Формат(Объект.ДатаОкончания, "ДФ ='дд.ММ.гггг'"));
		Элементы.ПериодОхоты.СписокВыбора.Добавить(ПериодОхоты,ПериодОхоты);
	КонецЕсли;
	
	СформироватьСтрокуПутевки();
	
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	Если НЕ Объект.СезонОхоты.Пустая() Тогда
		Элементы.СезонОхоты.ТолькоПросмотр = Истина;
	КонецЕсли;	
	
	
	Если НЕ Объект.Ответственный.Пустая() Тогда
		Элементы.Ответственный.ТолькоПросмотр = Истина;
	КонецЕсли;	
	
	Если НЕ Объект.Охотхозяйство.Пустая() Тогда
		Элементы.Охотхозяйство.ТолькоПросмотр = Истина;
	КонецЕсли;	

	Элементы.Группа1.ТолькоПросмотр = Объект.Обработан;
	//Элементы.Группа10.Видимость = НЕ Объект.Обработан;
	Элементы.ДекорацияРаспечатан.Видимость = Объект.Обработан;
	
	Для каждого элемент из Элементы.СтраницаОбщиеДанные.ПодчиненныеЭлементы Цикл
		УстановитьДоступность(элемент);	
	КонецЦикла;
	
	Элементы.Путевка_договор.Доступность = Истина;
	Элементы.СоздатьПутевку.Доступность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступность(Элемент)
	Если ТипЗнч(элемент) = Тип("ГруппаФормы") И Элемент.ПодчиненныеЭлементы.Количество() > 0 Тогда
		Для каждого эл из Элемент.ПодчиненныеЭлементы Цикл
			УстановитьДоступность(эл);
		КонецЦикла;
	ИначеЕсли ТипЗнч(элемент) = Тип("ПолеФормы") Тогда	
		
		Если элемент.Имя <> "Путевка_договор" ИЛИ элемент.Имя <> "СоздатьПутевку" Тогда
			элемент.ТолькоПросмотр = Объект.Обработан;
			Если элемент.Вид = ВидПоляФормы.ПолеВвода Тогда
				элемент.КнопкаОткрытия = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	


&НаКлиенте
Процедура ОхотхозяйствоПриИзменении(Элемент)
	Если Объект.МестоОхоты.Пустая() Тогда
		Объект.МестоОхоты = Объект.Охотхозяйство;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьВозможностьПечати(ИмяМакета)
	
	Если Объект.БезПроверки Тогда
		ОбязательныеПоля = ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОбязательныхРеквизитовРазрешения();
		Для каждого КлючИЗначение из ОбязательныеПоля Цикл
			Если КлючИЗначение.Значение Тогда
				Если НЕ ЗначениеЗаполнено(Объект[КлючИЗначение.Ключ]) Тогда
					Текст = "Не заполнены обязательные поля. Печать невозможна.";
					Поле = "Объект";
					ПоказатьСообщениеНаСервере(Текст,Поле);
					
					Возврат Ложь;

				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
		
	Иначе	
	
		Если Объект.Охотхозяйство.Пустая() 
			ИЛИ	Объект.СезонОхоты.Пустая()
			ИЛИ Объект.Охотник.Пустая()
			ИЛИ Объект.МестоОхоты.Пустая()
			ИЛИ Объект.ВидДичи.Пустая()
			ИЛИ Объект.ДатаНачала = '00010101'
			ИЛИ Объект.ДатаОкончания = '00010101'
			ИЛИ ПустаяСтрока(СокрЛП(Объект.СерияРазрешения))
			ИЛИ ПустаяСтрока(СокрЛП(Объект.НомерРазрешения)) Тогда
			
			Текст = "Не заполнены обязательные поля. Печать невозможна.";
			Поле = "Объект";
			ПоказатьСообщениеНаСервере(Текст,Поле);
			
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ Объект.Проведен Тогда
		Описание = Новый ОписаниеОповещения("ПроверкаВозможностиПечатиЗавершение",ЭтаФорма,ИмяМакета);
		ПоказатьВопрос(Описание,"Документ не проведен.Для печати его необходимо провести.
		|Провести документ?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		
		Возврат Ложь;					
	КонецЕсли;
	
	Если Модифицированность Тогда
		Описание = Новый ОписаниеОповещения("ПроверкаВозможностиПечатиЗавершение",ЭтаФорма,ИмяМакета);
		ПоказатьВопрос(Описание,"Документ изменен. Для печати его необходимо провести.
		|Провести документ?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		
		Возврат Ложь;					
	КонецЕсли;
	
	Возврат Истина;
	
	

КонецФункции

&НаКлиенте
Процедура ПроверкаПроведенияИМодифицированности(Путевка)
	Если НЕ Объект.Проведен Тогда
		ТекстВопроса = "Документ не проведен. Сначала следует провести документ.
		|Провести документ?";
		ПоказатьВопросНаФорме(ТекстВопроса,Путевка);					
		
		Возврат;
	ИначеЕсли Модифицированность  Тогда
		
		ТекстВопроса = "Документ был изменен. Документ следует перепровести.
		|Провести документ?";
		ПоказатьВопросНаФорме(ТекстВопроса,Путевка);					
		Возврат;		
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПроверкаВозможностиПечатиЗавершение(РезультатВопроса,ИмяМакета) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи",РежимЗаписиДокумента.Проведение);
		ЭтаФорма.Записать(ПараметрыЗаписи);
		
	Исключение
		ТекстОшибки = СформироватьТекстСообщенияНаСервере(ОписаниеОшибки());	
		
		Поле = "Объект";
		ПоказатьСообщениеНаСервере(ТекстОшибки,Поле);
		
		СформироватьЗаписьЖурналаНаСервере(ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	ОткрытьФормуПечати(ИмяМакета);
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция СформироватьТекстСообщенияНаСервере(ОписаниеОшибки)
	Возврат ОбщегоНазначения.СформироватьТекстСообщения(ОписаниеОшибки);	
КонецФункции	

&НаСервере
Процедура СформироватьЗаписьЖурналаНаСервере(ТекстОшибки)
	ОбщегоНазначения.СформироватьЗаписьЖурналаРегистрации("Данные.Проведение",УровеньЖурналаРегистрации.Ошибка,Объект.Ссылка.Метаданные(),Объект.Ссылка,ТекстОшибки);		
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	ИмяМакета = Команда.Имя;
	Если НЕ ПроверитьВозможностьПечати(ИмяМакета) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуПечати(ИмяМакета);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПечати(ИмяМакета)
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ИмяМакета",ИмяМакета);
	ПараметрыПечати.Вставить("Документ",Объект.Ссылка);
	ОткрытьФорму("ОбщаяФорма.ФормаПечати",ПараметрыПечати,ЭтаФорма,УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСтрокуПутевки() Экспорт
	Элементы.СоздатьПутевку.Заголовок = СформироватьСтрокуПутевкиНаСервере(Объект.ПутевкаДоговор); 
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьСтрокуПутевкиНаСервере(Ссылка)
	Возврат ОхотаСервер.ПолучитьТекстПутевки(Ссылка)
КонецФункции

&НаСервере
Процедура ОбновитьДанныеВПодчиненномДокументе(Отказ = Ложь,Путевка)
	Равны = РавныОбъекты(Объект.Ссылка,Путевка);
	Если Не Равны Тогда
		Если НЕ Путевка.Пустая() Тогда
			ОбъектПутевка = Путевка.ПолучитьОбъект();
		Иначе 
			Возврат;
		КонецЕсли;	
		
		ОбъектПутевка.Заполнить(Объект.Ссылка);
		
		
		Попытка
			ОбъектПутевка.Записать();
			Путевка = ОбъектПутевка.Ссылка;
			Объект.ПутевкаДоговор = Путевка;
			Записать();
		Исключение
			Отказ = Истина;
			ТекстОшибки = ОбщегоНазначения.СформироватьТекстСообщения(ОписаниеОшибки());	
			ОбщегоНазначения.СформироватьЗаписьЖурналаРегистрации("Данные.Проведение",УровеньЖурналаРегистрации.Ошибка,Объект.Ссылка.Метаданные(),Объект.Ссылка,ТекстОшибки);		
			
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	ПередЗакрытиемНаСервере(Отказ);
	Если НЕ Объект.Обработан И НЕ БылЗаданВопрос Тогда
		Отказ = Истина;
		БылЗаданВопрос = Истина;
		Оповещение = Новый ОписаниеОповещения("ПриЗакрытииЗавершение",ЭтаФорма,Отказ);
	
		ПоказатьВопрос(Оповещение,"Документ не распечатан. Закрыть?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да,"Обработка документа");
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура ПриЗакрытииЗавершение(Результат,Отказ) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Закрыть();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПередЗакрытиемНаСервере(Отказ)
	Путевка = Объект.ПутевкаДоговор;
	Если НЕ Путевка.Пустая() Тогда
		ОбновитьДанныеВПодчиненномДокументе(Отказ,Путевка);
	КонецЕсли;
КонецПроцедуры


&НаСервере
Функция РавныОбъекты(Разрешение,Путевка)
	
	СтруктураСравнения = Новый Структура
	("Дата,
	|СезонОхоты,
	|Охотхозяйство,
	|МестоОхоты,
	|Охотник,
	|ДатаНачала,
	|ДатаОкончания,
	|ВидДичи,
	|СерияРазрешения,
	|Сезонная,
	|НомерРазрешения,
	|Комментарий");
	
	//РеквизитыРазрешиния = Разрешение.Метаданные().Реквизиты;
	
	//ЗаполнитьЗначенияСвойств(СтруктураСравнения,Путевка);
	
	Для каждого КлючИЗначение из СтруктураСравнения Цикл
		Если Путевка[КлючИЗначение.Ключ] = Разрешение[КлючИЗначение.Ключ] Тогда
			Продолжить;
		Иначе
			Возврат Ложь;	
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ВладелецФормы <> Неопределено Тогда
		Если ТипЗнч(ВладелецФормы) = Тип("УправляемаяФорма") И СтрНайти(ВладелецФормы.ИмяФормы,"Список") <> 0 Тогда
			Если ВладелецФормы.ТекущаяСтрока <> Объект.Ссылка Тогда
				ВладелецФормы.ТекущаяСтрока = Объект.Ссылка;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Путевка = ПолучитьПутевку(Объект.Ссылка);
	Если Путевка.Пустая() Тогда
		Возврат;
	КонецЕсли;	
	Прочитать();
	ОбновитьДанныеВПодчиненномДокументе(,Путевка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "СформироватьСтрокуПутевки" 
		И Источник.ВладелецФормы = ЭтаФорма Тогда
		Объект.ПутевкаДоговор = Параметр;
		СформироватьСтрокуПутевки();
	ИначеЕсли ИмяСобытия = "ИзменениеДанныхОхотника" Тогда
		Объект.Охотник = Параметр;		
	ИначеЕсли ИмяСобытия = "Документ распечатан" Тогда
		Если Источник = "Разрешение" Тогда
			Если Параметр = "ЛицеваяСторона" Тогда
				РаспечатанаЛицеваяСторона  = Истина;
			ИначеЕсли Параметр = "ОбратнаяСторона" Тогда
				РаспечатанаОбратнаяСторона = Истина;
			КонецЕсли;
			Обработан = РаспечатанаЛицеваяСторона И РаспечатанаОбратнаяСторона;
			Если Объект.Обработан <> Обработан Тогда
				Объект.Обработан = Обработан;
				Записать();
			КонецЕсли;	
			УстановитьДоступностьЭлементов();
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДичиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если НЕ Объект.ВидДичи.Пустая() Тогда
		ПредыдущийВидДичи = Объект.ВидДичи;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.МестоОхоты) Тогда
		Текст = "Необходимо заполнить место охоты";
		Поле = "Объект.МестоОхоты";
		ПоказатьСообщениеНаСервере(Текст,Поле);
		Возврат;
	КонецЕсли;
	
	ДанныеВыбора = ПолучитьСписокВыбораВидаДичи();
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокВыбораВидаДичи()
	
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПоказатьСообщениеНаСервере(Текст,Поле)
	ОхотаСервер.ПоказатьСообщение(Текст,Поле);	
КонецПроцедуры

&НаКлиенте
Процедура ВидДичиПриИзменении(Элемент)
	Элементы.ПериодОхоты.СписокВыбора.Очистить();
	СписокДичи = ПолучитьСписокДичи(Объект.ВидДичи);
	Если Объект.ВидДичи = ПредыдущийВидДичи Тогда
		Возврат;
	Иначе	
		Объект.ДатаНачала = '00010101';
		Объект.ДатаОкончания = '00010101';
	КонецЕсли;
	
	
	
	

КонецПроцедуры

&НаКлиенте
Процедура ПериодОхотыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Объект.ВидДичи.Пустая() Тогда
		Текст = "Не заполнен вид дичи.
		|Невозможно подобрать актуальные периоды охоты!";
		Поле = "Объект.ВидДичи";
		ПоказатьСообщениеНаСервере(Текст,Поле);
		Возврат;
	КонецЕсли;	
	
	ПодобратьПериодыОхоты();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодОхотыПриИзменении(Элемент)
	
	ТекстДатаНачала = Сред(ПериодОхоты,3,10);
	ТекстДатаОкончания = Прав(ПериодОхоты,10);
	
	ДатаНачала = Дата(Прав(ТекстДатаНачала,4) + Сред(ТекстДатаНачала,4,2) + Лев(ТекстДатаНачала,2));
	ДатаОкончания = Дата(Прав(ТекстДатаОкончания,4) + Сред(ТекстДатаОкончания,4,2) + Лев(ТекстДатаОкончания,2));
	
	Объект.ДатаНачала = ДатаНачала;
	Объект.ДатаОкончания = ДатаОкончания;
	
КонецПроцедуры

&НаКлиенте
Процедура СезоннаяПриИзменении(Элемент)
	Объект.ДатаНачала = '00010101';
	Объект.ДатаОкончания = '00010101';
	
	ПериодОхоты = "";
	Элементы.ПериодОхоты.СписокВыбора.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ОхотникОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДанныеОхотника = ПолучитьДанныеОбОхотникеНаСервере(ВыбранноеЗначение);
	Если НЕ ДанныеОхотника.ЕстьГосБилет Тогда
		Описание = Новый ОписаниеОповещения("ОхотникОбработкаВыбораЗавершение",ЭтаФорма,ВыбранноеЗначение);
		ТекстВопроса = "Охотник не имеет действующего гос билета.
		|Хотите внести данные?";
		ПоказатьВопрос(Описание,ТекстВопроса,РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОхотникОбработкаВыбораЗавершение(РезультатВопроса,Охотник) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ",Охотник);
	ОткрытьФорму("Справочник.Охотники.Форма.ФормаЭлемента",ПараметрыФормы,ЭтаФорма,УникальныйИдентификатор);
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьДанныеОбОхотникеНаСервере(Охотник)
	Возврат ОхотаСерверПовтИсп.ПолучитьДанныеОхотника(Охотник);	
КонецФункции

&НаКлиенте
Процедура ДобытаяДичьПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Элементы.ДобытаяДичьДичь.СписокВыбора.Очистить();
	Если СписокДичи.Количество() > 0 Тогда
		Для каждого эл из СписокДичи Цикл
			Элементы.ДобытаяДичьДичь.СписокВыбора.Добавить(эл.Значение,эл.Представление);
		КонецЦикла;	
	КонецЕсли;	
	
	КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокДичи(ВидДичи)
	
	Если ВидДичи.Пустая() Тогда
		Возврат Новый СписокЗначений;
	Иначе
		Возврат ОхотаСерверПовтИсп.ПолучитьСписокДичи(ВидДичи,Ложь);	
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура ДобытаяДичьДичьОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если СписокДичи.НайтиПоЗначению(ВыбранноеЗначение) = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбранная дичь не относится к виду дичи, указанному в документе.");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПроизвольныйПериодПриИзменении(Элемент)
	Элементы.ГруппаПроизвольныйПериод.Видимость = Объект.ПроизвольныйПериод;
	Элементы.ПериодОхоты.Видимость = НЕ Объект.ПроизвольныйПериод;
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	Если Объект.ДатаНачала = '00010101' Тогда
		Возврат;
	КонецЕсли;	
	
	ОшибкиПериода = ПолучитьПроизвольныеПериодыОхоты(Объект.ВидДичи,Объект.СезонОхоты,Объект.ДатаНачала,Объект.ДатаОкончания,Объект.Дата,Элемент.Имя);
	
	Если ОшибкиПериода.Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОшибкиПериода.ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	Если Объект.ДатаОкончания = '00010101' Тогда
		Возврат;
	КонецЕсли;
	ОшибкиПериода = ПолучитьПроизвольныеПериодыОхоты(Объект.ВидДичи,Объект.СезонОхоты,Объект.ДатаНачала,Объект.ДатаОкончания,Объект.Дата,Элемент.Имя);
	Если ОшибкиПериода.Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОшибкиПериода.ТекстОшибки);		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПроизвольныеПериодыОхоты(ВидДичи,СезонОхоты,ДатаНачала,ДатаОкончания,ДатаСреза,Элемент)
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Отказ",Ложь);
		
	Если ВидДичи.Пустая() Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки","Не заполнен вид дичи");
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИНИМУМ(ЦеныПоВидамДичи.ДатаНачала) КАК ДатаНачала,
		|	МАКСИМУМ(ЦеныПоВидамДичи.ДатаОкончания) КАК ДатаОкончания
		|ИЗ
		|	РегистрСведений.ЦеныПоВидамДичи.СрезПоследних(
		|			&ДатаСреза,
		|			ВидДичи = &ВидДичи
		|				И СезонОхоты = &СезонОхоты) КАК ЦеныПоВидамДичи
		|
		|ИМЕЮЩИЕ
		|	НЕ МИНИМУМ(ЦеныПоВидамДичи.ДатаНачала) ЕСТЬ NULL  И
		|	НЕ МАКСИМУМ(ЦеныПоВидамДичи.ДатаОкончания) ЕСТЬ NULL ";
	
	Запрос.УстановитьПараметр("ВидДичи", ВидДичи);
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	Запрос.УстановитьПараметр("СезонОхоты", СезонОхоты);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки","Не определены периоды охоты");
		ДатаНачала = '00010101';
		ДатаОкончания = '00010101';
		Возврат СтруктураОтвета;
	КонецЕсли;	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();	
	
	Если ДатаНачала <> '00010101' И ДатаНачала < Выборка.ДатаНачала Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки",("Дата начала периода охоты не может быть ранее " + Формат(Выборка.ДатаНачала,"ДФ=dd.MM.yyyy")));
		ДатаНачала = Выборка.ДатаНачала;
		Возврат СтруктураОтвета;
	ИначеЕсли ДатаНачала > Выборка.ДатаОкончания Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки",("Дата начала периода охоты не может быть позже " + Формат(Выборка.ДатаОкончания,"ДФ=dd.MM.yyyy")));
		ДатаНачала = Выборка.ДатаНачала;
		Возврат СтруктураОтвета;
	ИначеЕсли ДатаОкончания <> '00010101' И ДатаОкончания < Выборка.ДатаНачала Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки",("Дата окончания периода охоты не может быть ранее " + Формат(Выборка.ДатаНачала,"ДФ=dd.MM.yyyy")));
		ДатаОкончания = Выборка.ДатаОкончания;
		Возврат СтруктураОтвета;
	ИначеЕсли ДатаОкончания > Выборка.ДатаОкончания Тогда
		СтруктураОтвета.Вставить("Отказ",Истина);
		СтруктураОтвета.Вставить("ТекстОшибки",("Дата окончания периода охоты не может быть позже " + Формат(Выборка.ДатаОкончания,"ДФ=dd.MM.yyyy")));
		ДатаОкончания = Выборка.ДатаОкончания;
		Возврат СтруктураОтвета;
	ИначеЕсли ДатаНачала > ДатаОкончания И ДатаОкончания <> '00010101' Тогда
		Если Элемент = "ДатаНачала" Тогда
			СтруктураОтвета.Вставить("Отказ",Истина);
			СтруктураОтвета.Вставить("ТекстОшибки","Дата начала периода охоты не может быть позже даты окончания");
			ДатаНачала = '00010101';
			Возврат СтруктураОтвета;
		ИначеЕсли Элемент = "ДатаОкончания" Тогда
			СтруктураОтвета.Вставить("Отказ",Истина);
			СтруктураОтвета.Вставить("ТекстОшибки","Дата окончания периода охоты не может быть раньше даты начала");
			ДатаОкончания = '00010101';
			Возврат СтруктураОтвета;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат СтруктураОтвета;
		
	
КонецФункции	

&НаКлиенте
Процедура ОбработанПриИзменении(Элемент)
	УстановитьДоступностьЭлементов();
	Если НЕ Объект.Ссылка.Пустая() И НЕ Объект.Обработан Тогда
		ЭтаФорма.Записать(Новый Структура("РежимЗаписи",РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	РаспечатанаЛицеваяСторона = Объект.Обработан;
	РаспечатанаОбратнаяСторона = Объект.Обработан;
КонецПроцедуры

