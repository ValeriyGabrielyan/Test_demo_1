
Процедура ПолучитьТабДок(ТабДок, ТабДокДляПечати,ПараметрыПечати) Экспорт
	
	Макет 			= Документы.ПутевкаДоговор.ПолучитьМакет(ПараметрыПечати.ИмяМакета);
	МакетДляПечати 	= Документы.ПутевкаДоговор.ПолучитьМакет(ПараметрыПечати.ИмяМакета + "ДляПечати");
	
	Ссылка 			= ПараметрыПечати.Документ;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Путевка.СезонОхоты,
	|	Путевка.МестоОхоты.НаименованиеДляПечати КАК МестоОхоты,
	|	Путевка.МестоОхоты КАК МестоОхотыСсылка,
	|	Путевка.ВидДичи,
	|	Путевка.Дата,
	|	Путевка.ДатаНачала,
	|	Путевка.ДатаОкончания,
	|	Путевка.СерияРазрешения КАК Серия,
	|	Путевка.НомерРазрешения КАК Номер,
	|	Путевка.Ответственный.Представление КАК ИсполнительФИО,
	|	Путевка.Охотхозяйство.Наименование КАК Охотхозяйство,
	|	Путевка.Охотхозяйство.ИНН КАК ИНН,
	|	Путевка.Охотхозяйство.Адрес КАК Адрес,
	|	Путевка.Охотник.Фамилия + "" "" + Путевка.Охотник.Имя + "" "" + Путевка.Охотник.Отчество КАК ОхотникФИО,
	|	Путевка.Охотник.Фамилия + "" "" + ПОДСТРОКА(Путевка.Охотник.Имя, 1, 1) + ""."" + ПОДСТРОКА(Путевка.Охотник.Отчество, 1, 1) + ""."" КАК ОхотникИнициалы,
	|	ЕСТЬNULL(ОхотничьиБилеты.КемВыдан.НаименованиеПолное, """") КАК КемВыдан,
	|	ЕСТЬNULL(ОхотничьиБилеты.КемВыдан.Наименование, """") КАК КемВыданСокр,
	|	ЕСТЬNULL(ОхотничьиБилеты.Серия, """") КАК СерияБилета,
	|	ЕСТЬNULL(ОхотничьиБилеты.Номер, """") КАК НомерБилета,
	|	Путевка.Охотхозяйство.СубъектРФ.Наименование КАК СубъектРФ,
	|	Путевка.Стоимость,
	|	ЕСТЬNULL(СотрудникиПользователя.Сотрудник.Должность.Наименование, """") КАК Должность,
	|	Путевка.МестоОхоты.ДниОхоты КАК ДниОхоты
	|ПОМЕСТИТЬ ВТ1
	|ИЗ
	|	Документ.ПутевкаДоговор КАК Путевка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОхотничьиБилеты КАК ОхотничьиБилеты
	|		ПО Путевка.Охотник = ОхотничьиБилеты.Охотник
	|			И (ОхотничьиБилеты.ВидБилета = ЗНАЧЕНИЕ(Перечисление.ВидыОхотничьихБилетов.ЧленскийБилет))
	|			И (ОхотничьиБилеты.Действует)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиПользователя КАК СотрудникиПользователя
	|		ПО Путевка.Ответственный = СотрудникиПользователя.Пользователь
	|ГДЕ
	|	Путевка.Ссылка В(&Ссылка)
	|;
	|
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ограничение.Дичь КАК Дичь
	|ПОМЕСТИТЬ ВТОграничение
	|ИЗ
	|	РегистрСведений.Ограничение КАК Ограничение
	|ГДЕ
	|	(Ограничение.СезонОхоты, Ограничение.Охотхозяйство) В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Т.СезонОхоты,
	|				Т.МестоОхотыСсылка
	|			ИЗ
	|				ВТ1 КАК Т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ1.СезонОхоты,
	|	ВТ1.ВидДичи,
	|	ВТ1.МестоОхоты,
	|	ВТ1.Дата,
	|	ВТ1.ДатаНачала,
	|	ВТ1.ДатаОкончания,
	|	ВТ1.Серия,
	|	ВТ1.Номер,
	|	ВТ1.ИсполнительФИО,
	|	ВТ1.Охотхозяйство,
	|	ВТ1.ИНН,
	|	ВТ1.Адрес,
	|	ВТ1.ОхотникФИО,
	|	ВТ1.ОхотникИнициалы,
	|	ВТ1.КемВыдан,
	|	ВТ1.КемВыданСокр,
	|	ВТ1.СерияБилета,
	|	ВТ1.НомерБилета,
	|	ВТ1.СубъектРФ,
	|	ВТ1.Стоимость,
	|	ВТ1.Должность,
	|	ВТ1.ДниОхоты
	|ИЗ
	|	ВТ1 КАК ВТ1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ1.ДатаНачала,
	|	ВТ1.ДатаОкончания,
	|	ПерваяСтрочкаЦены.КлючСвязи,
	|	ПерваяСтрочкаЦены.ВидДичи
	|ПОМЕСТИТЬ ВТ2
	|ИЗ
	|	РегистрСведений.ЦеныПоВидамДичи.СрезПоследних(
	|			&Дата,
	|			СезонОхоты = &СезонОхоты
	|				И ВидДичи = &ВидДичи) КАК ПерваяСтрочкаЦены
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ1 КАК ВТ1
	|		ПО (ИСТИНА)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПерваяСтрочкаЦены.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ2.ДатаНачала,
	|	ВТ2.ДатаОкончания,
	|	УстановкаОграниченийИЦенСостав.Дичь КАК ВидРесурсов,
	|	УстановкаОграниченийИЦенСостав.Ограничено КАК Ограничено,
	|	УстановкаОграниченийИЦенСостав.КоличествоВДень КАК КоличествоВДень,
	|	УстановкаОграниченийИЦенСостав.КоличествоЗаСезон КАК КоличествоЗаСезон,
	|	УстановкаОграниченийИЦенСостав.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ПерваяСтрочкаСостав
	|ИЗ
	|	ВТ2 КАК ВТ2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УстановкаОграниченийИЦен.Состав КАК УстановкаОграниченийИЦенСостав
	|		ПО ВТ2.КлючСвязи = УстановкаОграниченийИЦенСостав.КлючСвязи
	|ГДЕ
	|	НЕ УстановкаОграниченийИЦенСостав.Дичь В
	|				(ВЫБРАТЬ
	|					Т.Дичь
	|				ИЗ
	|					ВТОграничение КАК Т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ1.ДатаНачала КАК ДатаНачала,
	|	ВТ1.ДатаОкончания КАК ДатаОкончания,
	|	ОграниченияДичи.Дичь КАК ВидРесурсов,
	|	ОграниченияДичи.Ограничено,
	|	ОграниченияДичи.КоличествоВДень,
	|	ОграниченияДичи.КоличествоЗаСезон,
	|	ОграниченияДичи.НомерСтроки,
	|	ОграниченияДичи.КлючСвязи
	|ПОМЕСТИТЬ Исходная
	|ИЗ
	|	ВТ1 КАК ВТ1
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныПоВидамДичи.СрезПоследних(
	|				&Дата,
	|				СезонОхоты = &СезонОхоты
	|					И ВидДичи = &ВидДичи) КАК ЦеныПоВидамДичи
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОграниченияДичиНаДобычу.СрезПоследних(
	|					&Дата,
	|					СезонОхоты = &СезонОхоты
	|						И ВидДичи = &ВидДичи) КАК ОграниченияДичи
	|			ПО ЦеныПоВидамДичи.КлючСвязи = ОграниченияДичи.КлючСвязи
	|		ПО (ВЫБОР
	|				КОГДА &ТолькоСезонная
	|					ТОГДА ВТ1.ДатаНачала = ЦеныПоВидамДичи.ДатаНачала
	|							И ВТ1.ДатаОкончания = ЦеныПоВидамДичи.ДатаОкончания
	|				ИНАЧЕ ВТ1.ДатаНачала >= ЦеныПоВидамДичи.ДатаНачала
	|						И ВТ1.ДатаОкончания <= ЦеныПоВидамДичи.ДатаОкончания
	|			КОНЕЦ)
	|ГДЕ
	|	НЕ ОграниченияДичи.Дичь В
	|				(ВЫБРАТЬ
	|					Т.Дичь
	|				ИЗ
	|					ВТОграничение КАК Т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(исходная.ДатаНачала, ПерваяСтрочка.ДатаНачала) КАК ДатаНачала,
	|	ЕСТЬNULL(исходная.ДатаОкончания, ПерваяСтрочка.ДатаОкончания) КАК ДатаОкончания,
	|	ЕСТЬNULL(исходная.ВидРесурсов, ПерваяСтрочка.ВидРесурсов) КАК ВидРесурсов,
	|	ЕСТЬNULL(исходная.Ограничено, ПерваяСтрочка.Ограничено) КАК Ограничено,
	|	ЕСТЬNULL(исходная.КоличествоВДень, ПерваяСтрочка.КоличествоВДень) КАК КоличествоВДень,
	|	ЕСТЬNULL(исходная.КоличествоЗаСезон, ПерваяСтрочка.КоличествоЗаСезон) КАК КоличествоЗаСезон,
	|	ЕСТЬNULL(исходная.НомерСтроки, ПерваяСтрочка.НомерСтроки) КАК НомерСтроки
	|ИЗ
	|	Исходная КАК исходная
	|		ПОЛНОЕ СОЕДИНЕНИЕ ПерваяСтрочкаСостав КАК ПерваяСтрочка
	|		ПО исходная.ВидРесурсов = ПерваяСтрочка.ВидРесурсов
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";

	
	мПериоды = ОхотаСервер.ПолучитьПериодыОхоты(Ссылка); 
	Периоды = мПериоды.Выгрузить();
	ТолькоСезонная = Истина;
	Для каждого стр из Периоды Цикл
		ТолькоСезонная = ТолькоСезонная И стр.ТолькоСезонная;
	КонецЦикла;		

	
	Запрос.Параметры.Вставить("ТолькоСезонная",ТолькоСезонная);
	Запрос.Параметры.Вставить("ВозрастнойПорог",Константы.ВозрастнойПорогЛьготнойСтоимости.Получить());
	Запрос.Параметры.Вставить("СезонОхоты",Ссылка.СезонОхоты);
	Запрос.Параметры.Вставить("ВидДичи",Ссылка.ВидДичи);
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	Запрос.Параметры.Вставить("Дата",Ссылка.Дата);	
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[2].Выбрать();

	УстановитьПривилегированныйРежим(Ложь);
	
	ОбластьПутевка 				= Макет.ПолучитьОбласть("Путевка");
	ОбластьПутевкаДляПечати 	= МакетДляПечати.ПолучитьОбласть("Путевка");
	
	ТабДок.Очистить();
	ТабДокДляПечати.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		ОбластьПутевка.Параметры.Заполнить(Выборка);
				
		
		ГодНачалаОхоты 		= Формат(Выборка.ДатаНачала,"ДФ = гг" ); 
		МесяцНачалаОхоты	= Формат(Выборка.ДатаНачала,"ДФ = ММ" );
		ДеньНачалаОхоты		= Формат(Выборка.ДатаНачала,"ДФ = дд" ); 
		
		ГодКонецОхоты 		= Формат(Выборка.ДатаОкончания,"ДФ = гг" ); 
		МесяцКонецОхоты		= Формат(Выборка.ДатаОкончания,"ДФ = ММ" );
		ДеньКонецОхоты		= Формат(Выборка.ДатаОкончания,"ДФ = дд" ); 
		
		ГодРегистрации 		= Формат(Выборка.Дата,"ДФ = гг" ); 
		МесяцРегистрации 	= Формат(Выборка.Дата,"ДФ = ММ" ); 
		ДеньРегистрации		= Формат(Выборка.Дата,"ДФ = дд" ); 
		
		ОбластьПутевка.Параметры.КемВыданСтр1 	= Выборка.КемВыданСокр;
		
		ОбластьПутевка.Параметры.ГодНачалаОхоты 	= ГодНачалаОхоты;
		ОбластьПутевка.Параметры.МесяцНачалаОхоты 	= МесяцНачалаОхоты;
		ОбластьПутевка.Параметры.ДеньНачалаОхоты 	= ДеньНачалаОхоты;
		
		ОбластьПутевка.Параметры.ГодКонецОхоты 		= ГодКонецОхоты;
		ОбластьПутевка.Параметры.МесяцКонецОхоты 	= МесяцКонецОхоты;
		ОбластьПутевка.Параметры.ДеньКонецОхоты 	= ДеньКонецОхоты;
		
		ОбластьПутевка.Параметры.ГодОплаты 			= ГодРегистрации;
		ОбластьПутевка.Параметры.МесяцОплаты		= МесяцРегистрации;
		ОбластьПутевка.Параметры.ДеньОплаты 		= ДеньРегистрации;
		
		СтоимостьПутевки = Выборка.Стоимость;
		
		Если СтоимостьПутевки > 0 Тогда
		
			СтоимостьПутевкиСтрока = ЧислоПрописью(СтоимостьПутевки); //,,"рубль, рубля, рублей, м, копейка, копейки, копеек, ж");
			СтоимостьПутевкиСтрока = СтрЗаменить(СтоимостьПутевкиСтрока," 00","");
			
			ОбластьПутевка.Параметры.СтоимостьПрописью = СтоимостьПутевкиСтрока;  
			
			ОбластьПутевка.Параметры.Стоимость = СтоимостьПутевки;
		КонецЕсли;		
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(ОбластьПутевкаДляПечати.Параметры,ОбластьПутевка.Параметры);
	
	Выборка = Пакет[6].Выбрать();
		
		а = 1;
		ВидыРесурсов = Новый Структура;
		ВидыРесурсовДляПечати = Новый Структура;
		
		Пока Выборка.Следующий() Цикл
			ВидыРесурсов.Вставить("Номер" + Строка(а),а );
			ВидыРесурсовДляПечати.Вставить("Номер" + Строка(а),?((а=1 ИЛИ а=2),"",а ));
			
			ВидыРесурсов.Вставить("ВидРесурсов" + Строка(а),Выборка.ВидРесурсов);
			ВидыРесурсовДляПечати.Вставить("ВидРесурсов" + Строка(а),Выборка.ВидРесурсов);
			
			Если Выборка.Ограничено Тогда
				ВидыРесурсов.Вставить("Норма" + Строка(а),Строка(Макс(Выборка.КоличествоВДень,Выборка.КоличествоЗаСезон)) + " шт");
				ВидыРесурсовДляПечати.Вставить("Норма" + Строка(а),Строка(Макс(Выборка.КоличествоВДень,Выборка.КоличествоЗаСезон)) + " шт");
			Иначе
				ВидыРесурсов.Вставить("Норма" + Строка(а),"НЕОГР");
				ВидыРесурсовДляПечати.Вставить("Норма" + Строка(а),"НЕОГР");
			КонецЕсли;			
		а = а + 1; 	
		КонецЦикла;
	ОбластьПутевка.Параметры.Заполнить(ВидыРесурсов);
	ОбластьПутевкаДляПечати.Параметры.Заполнить(ВидыРесурсовДляПечати);

	ТабДок.Вывести(ОбластьПутевка);
	ТабДокДляПечати.Вывести(ОбластьПутевкаДляПечати);
	
	ТабДокДляПечати.ПолеСверху 		= 14;
	ТабДокДляПечати.ПолеСнизу 		= 5.5;
	ТабДокДляПечати.ПолеСлева 		= 18.3;
	ТабДокДляПечати.ПолеСправа 		= 0;

	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокДляПечати.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
КонецПроцедуры



