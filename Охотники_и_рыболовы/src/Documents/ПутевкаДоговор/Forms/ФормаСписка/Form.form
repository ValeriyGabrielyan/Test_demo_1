    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументПутевкаДоговор.Номер,
	ДокументПутевкаДоговор.Дата,
	ДокументПутевкаДоговор.СерияПутевки,
	ДокументПутевкаДоговор.НомерПутевки,
	ДокументПутевкаДоговор.Охотник,
