	Объект.Стоимость = СтоимостьАктуальная;
	Попытка
		Записать();
	Исключение
		ТекстОшибки = ОбщегоНазначения.СформироватьТекстСообщения(ОписаниеОшибки());	
		ОбщегоНазначения.СформироватьЗаписьЖурналаРегистрации("Данные.Проведение",УровеньЖурналаРегистрации.Ошибка,Объект.Ссылка.Метаданные(),Объект.Ссылка,ТекстОшибки);		
		Объект.Стоимость = СтоимостьНеАктуальная;
	КонецПопытки;
	
КонецПроцедуры


