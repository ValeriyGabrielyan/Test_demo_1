&НаСервереБезКонтекста
Функция ПроверитьКорректностьПодбора(Разрешение,Путевка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(РазрешениеНаОхоту.Ссылка) КАК Разрешение
		|ИЗ
		|	Документ.РазрешениеНаОхоту КАК РазрешениеНаОхоту
		|ГДЕ
		|	РазрешениеНаОхоту.Ссылка = &Разрешение
		|	И РазрешениеНаОхоту.ПутевкаДоговор <> &Путевка
		|	И РазрешениеНаОхоту.Проведен";
	
	Запрос.УстановитьПараметр("Путевка", Путевка);
	Запрос.УстановитьПараметр("Разрешение", Разрешение);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий(); 
	
	Разрешение = Выборка.Разрешение;
	
	Возврат Ложь;
	
КонецФункции	

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если НЕ ПроверитьКорректностьПодбора(ВыбранноеЗначение,Объект.Ссылка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Разрешение " + ВыбранноеЗначение + " уже является основанием для другой путевки.");
		Возврат;
	КонецЕсли;	
	
	Если Тип(ИсточникВыбора) = Тип("УправляемаяФорма") Тогда
		Если Объект.Охотник.Пустая() И Объект.ВидДичи.Пустая() Тогда
			ЗаполнитьОбъект(ВыбранноеЗначение);
			Записать();
			СтоимостьАктуальная =  ПолучитьСтоимостьПутевки(ПолучитьПараметрыДанных());
			Объект.Стоимость = СтоимостьАктуальная;
			ПриОткрытии(Ложь);
		Иначе
			Описание = Новый ОписаниеОповещения("ОбработкаОповещенияЗавершение",ЭтаФорма,ВыбранноеЗначение);
			ПоказатьВопрос(Описание,"Документ не пустой. Продолжить?",РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры


