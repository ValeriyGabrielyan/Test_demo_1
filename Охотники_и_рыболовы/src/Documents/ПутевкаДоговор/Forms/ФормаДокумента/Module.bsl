
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийСезон = ОхотаСерверПовтИсп.ПолучитьТекущийСезон();
	
	Если ТекущийСезон.Пустая() Тогда
		ТекстСообщения = "Сезон охоты не открыт";
		Поле = "Объект.СезонОхоты";
		ОхотаСервер.ПоказатьСообщение(ТекстСообщения,Поле);
		Отказ = Истина;
		Возврат;
	Иначе
		Если Объект.СезонОхоты.Пустая() Тогда 
			Объект.СезонОхоты = ТекущийСезон;
		КонецЕсли;
		Элементы.СезонОхоты.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ДокументОснование = Объект.ДокументОснование;
	БезПроверки = ДокументОснование.БезПроверки;
	
	ОснОтветственный = ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ОсновнойОтветственный");
	
	Если Объект.Ответственный.Пустая() Тогда
		Объект.Ответственный = ОхотаСерверПовтИсп.ПолучитьНастройкуПользователя(ОснОтветственный);	
	КонецЕсли;	
	
	Если РольДоступна("ПолныеПрава") Тогда
		Элементы.Охотхозяйство.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Сезонная = ДокументОснование.Сезонная;
		ОснОрганизация = ПредопределенноеЗначение("ПланВидовХарактеристик.НастройкиПользователей.ОсновнаяОрганизация");
		
		Охотхозяйство = ОхотаСерверПовтИсп.ПолучитьНастройкуПользователя(ОснОрганизация);
		Если Объект.Охотхозяйство.Пустая() Тогда
			Объект.Охотхозяйство = Охотхозяйство;
		КонецЕсли;	
		
		Если Объект.МестоОхоты.Пустая() Тогда
			Объект.МестоОхоты = Охотхозяйство;
		КонецЕсли;	
	Иначе	
		
		ПолучитьПериодыОхоты(Истина);
	КонецЕсли;
	
	СтоимостьАктуальная = ПолучитьСтоимостьПутевки(ПолучитьПараметрыДанных());
	
	Если Объект.Ссылка.Пустая() И Объект.Стоимость = 0 Тогда
		Объект.Стоимость = СтоимостьАктуальная;
	КонецЕсли;
	
	ПараметрыВыбораПоСубъекту = ОхотаСерверПовтИсп.ПолучитьПараметрыВыбораПоСубъектуРФ();
	Элементы.МестоОхоты.ПараметрыВыбора = ПараметрыВыбораПоСубъекту;
	Элементы.Охотхозяйство.ПараметрыВыбора = ПараметрыВыбораПоСубъекту;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	Если НЕ Объект.Стоимость = СтоимостьАктуальная Тогда
		Элементы.Скорректировать.Видимость = Истина;
		Элементы.СтоимостьАктуальна.Заголовок = "Стоимость не актуальна";
		Элементы.СтоимостьАктуальна.ЦветТекста = ЦветаСтиля.Некорректно;
	Иначе 	
		Элементы.Скорректировать.Видимость = Ложь;		
		Элементы.СтоимостьАктуальна.Заголовок = "Стоимость актуальна";
		Элементы.СтоимостьАктуальна.ЦветТекста = ЦветаСтиля.Корректно;
	КонецЕсли;
	
	Если Объект.Охотхозяйство.Пустая() ИЛИ Объект.МестоОхоты.Пустая() ИЛИ
		Объект.Охотник.Пустая() ИЛИ Объект.ВидДичи.Пустая() Тогда
		Элементы.ПериодОхоты.ТолькоПросмотр = Истина;
		Элементы.ДатаНачала.ТолькоПросмотр = Истина;
		Элементы.ДатаОкончания.ТолькоПросмотр = Истина;
	Иначе
		Элементы.ПериодОхоты.ТолькоПросмотр = Ложь;
		Элементы.ДатаНачала.ТолькоПросмотр = Ложь;
		Элементы.ДатаОкончания.ТолькоПросмотр = Ложь;
	КонецЕсли;	
	
	Если Объект.ДокументОснование.Пустая() Тогда
		Элементы.Группа1.ТолькоПросмотр =Ложь;
		Элементы.Группа3.ТолькоПросмотр =Ложь;
		Элементы.Группа8.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.Группа1.ТолькоПросмотр = Истина;
		Элементы.Группа3.ТолькоПросмотр = Истина;
		Элементы.Группа8.ТолькоПросмотр = Истина;
	КонецЕсли;	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтоимостьПутевки(ПараметрыДанных)
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&СезонОхоты,
	|	&Охотхозяйство,
	|	&МестоОхоты,
	|	ВЫРАЗИТЬ(&Охотник КАК Справочник.Охотники) КАК Охотник,
	|	&ВидДичи,
	|	&Сезонная,
	|	&ДатаНачала,
	|	&ДатаОкончания,
	|	&Дата
	|ПОМЕСТИТЬ ПутевкаДоговор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ПутевкаДоговор.Охотник.ШтатныйСотрудник
	|			ТОГДА ЕСТЬNULL(ЦеныПоВидам.ЦенаШтатнымСотрудникам, 0)
	|		ИНАЧЕ 999999999
	|	КОНЕЦ КАК ЦенаШтатномуСотруднику,
	|	ВЫБОР
	|		КОГДА ПутевкаДоговор.Охотник.ВетеранВОВ
	|			ТОГДА ЕСТЬNULL(ЦеныПоВидам.ЦенаВетеранамВойны, 0)
	|		ИНАЧЕ 999999999
	|	КОНЕЦ КАК ЦенаВетерануВОВ,
	|	ВЫБОР
	|		КОГДА ПутевкаДоговор.Охотник.Инвалид1Группы
	|			ТОГДА ЕСТЬNULL(ЦеныПоВидам.ЦенаИнвалидамПервойГруппы, 0)
	|		ИНАЧЕ 999999999
	|	КОНЕЦ КАК ЦенаИнвалидуПервойГруппы,
	|	ВЫБОР
	|		КОГДА ГОД(ПутевкаДоговор.Дата) - ГОД(ПутевкаДоговор.Охотник.ДатаРождения) >= &ВозрастнойПорог
	|			ТОГДА ЕСТЬNULL(ЦеныПоВидам.ЦенаПослеВозрастногоПорога, 0)
	|		ИНАЧЕ 999999999
	|	КОНЕЦ КАК ЦенаПоВозрасту,
	|	ВЫБОР
	|		КОГДА ПутевкаДоговор.Охотник.ЧленОООР
	|			ТОГДА ВЫБОР
	|					КОГДА ПутевкаДоговор.Охотник.ЧленККОООР = ИСТИНА
	|						ТОГДА ВЫБОР
	|								КОГДА ПутевкаДоговор.Сезонная
	|										ИЛИ ЦеныПоВидам.ТолькоСезонная
	|									ТОГДА ЕСТЬNULL(ЦеныПоВидам.ЦенаСвоимСезонная, 0)
	|								ИНАЧЕ ЕСТЬNULL(ЦеныПоВидам.ЦенаСвоимРазовая, 0) * РАЗНОСТЬДАТ(ПутевкаДоговор.ДатаНачала, ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(ПутевкаДоговор.ДатаОкончания, ДЕНЬ), СЕКУНДА, 1), ДЕНЬ)
	|							КОНЕЦ
	|					ИНАЧЕ ВЫБОР
	|							КОГДА ПутевкаДоговор.Сезонная
	|									ИЛИ ЦеныПоВидам.ТолькоСезонная
	|								ТОГДА ЕСТЬNULL(ЦеныПоВидам.ЦенаЧужимСезонная, 0)
	|							ИНАЧЕ ЕСТЬNULL(ЦеныПоВидам.ЦенаЧужимРазовая, 0) * РАЗНОСТЬДАТ(ПутевкаДоговор.ДатаНачала, ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(ПутевкаДоговор.ДатаОкончания, ДЕНЬ), СЕКУНДА, 1), ДЕНЬ)
	|						КОНЕЦ
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПутевкаДоговор.Сезонная
	|						ИЛИ ЦеныПоВидам.ТолькоСезонная
	|					ТОГДА ЕСТЬNULL(ЦеныПоВидам.ТолькоГосБилетСезонная, 0)
	|				ИНАЧЕ ЕСТЬNULL(ЦеныПоВидам.ТолькоГосБилетРазовая, 0) * РАЗНОСТЬДАТ(ПутевкаДоговор.ДатаНачала, ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(ПутевкаДоговор.ДатаОкончания, ДЕНЬ), СЕКУНДА, 1), ДЕНЬ)
	|			КОНЕЦ
	|	КОНЕЦ КАК СтоимостьПутевки,
	|	ЕСТЬNULL(ЦеныПоВидам.ДействиеОсобыхЦен, ЛОЖЬ) КАК ДействиеОсобыхЦен
	|ИЗ
	|	ПутевкаДоговор КАК ПутевкаДоговор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныПоВидамДичи.СрезПоследних(&Дата, ) КАК ЦеныПоВидам
	|		ПО ПутевкаДоговор.СезонОхоты = ЦеныПоВидам.СезонОхоты
	|			И ПутевкаДоговор.ВидДичи = ЦеныПоВидам.ВидДичи
	|			И (ПутевкаДоговор.ДатаНачала МЕЖДУ ЦеныПоВидам.ДатаНачала И ЦеныПоВидам.ДатаОкончания)
	|			И (ПутевкаДоговор.ДатаОкончания МЕЖДУ ЦеныПоВидам.ДатаНачала И ЦеныПоВидам.ДатаОкончания)"; 		
	
	Для каждого КлючИЗначение Из ПараметрыДанных Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ,КлючИЗначение.Значение);
	КонецЦикла;	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СтоимостьПутевки = 0;
	
	Охотник = ПараметрыДанных.Охотник;
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ДействиеОсобыхЦен Тогда
			Стоимость = 999999999;
			
			Если Охотник.ШтатныйСотрудник Тогда
				Стоимость = Выборка.ЦенаШтатномуСотруднику;
			КонецЕсли;	
			
			Если Охотник.ВетеранВОВ Тогда
				Стоимость = Выборка.ЦенаВетерануВОВ;
			КонецЕсли;	
			
			Если Охотник.Инвалид1Группы Тогда
				Стоимость = Выборка.ЦенаИнвалидуПервойГруппы;
			КонецЕсли;	
			
			ВозрастОхотника = Год(ПараметрыДанных.Дата) - Год(Охотник.ДатаРождения);
			
			Если ВозрастОхотника >= ПараметрыДанных.ВозрастнойПорог И ВозрастОхотника < 100 Тогда
				Стоимость = Выборка.ЦенаПоВозрасту;
			КонецЕсли;	
		
		
			СтоимостьПутевки = Мин(Стоимость,Выборка.СтоимостьПутевки);	
		Иначе
			СтоимостьПутевки = Выборка.СтоимостьПутевки;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат СтоимостьПутевки	
КонецФункции

&НаКлиенте
Процедура Печать(Команда)
	ИмяМакета = Команда.Имя;
	
	Если Не ПроверитьВозможностьПечати(ИмяМакета) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуПечати(ИмяМакета);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПечати(ИмяМакета)
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ИмяМакета",ИмяМакета);
	ПараметрыПечати.Вставить("Документ",Объект.Ссылка);
	ОткрытьФорму("ОбщаяФорма.ФормаПечати",ПараметрыПечати,ЭтаФорма,УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Функция ПроверитьВозможностьПечати(ИмяМакета)
	Если ПустаяСтрока(Объект.СерияПутевки) Тогда
		Текст = "Не заполнена серия путевки";
		Поле = "Объект.СерияПутевки";
		ПоказатьСообщениеНаСервере(Текст,Поле);
		Возврат Ложь;
	ИначеЕсли ПустаяСтрока(Объект.НомерПутевки) Тогда
		Текст = "Не заполнен номер путевки";
		Поле = "Объект.НомерПутевки";
		ПоказатьСообщениеНаСервере(Текст,Поле);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ Объект.Проведен Тогда
		Описание = Новый ОписаниеОповещения("ПроверкаВозможностиПечатиЗавершение",ЭтаФорма,ИмяМакета);
		ПоказатьВопрос(Описание,"Документ не проведен.Для печати его необходимо провести.
		|Провести документ?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		
		Возврат Ложь;					
	КонецЕсли;
	
	Если Модифицированность Тогда
		Описание = Новый ОписаниеОповещения("ПроверкаВозможностиПечатиЗавершение",ЭтаФорма,ИмяМакета);
		ПоказатьВопрос(Описание,"Документ изменен. Для печати его необходимо провести.
		|Провести документ?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		
		Возврат Ложь;					
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПроведенДокументОснование()
	Возврат Объект.ДокументОснование.Проведен;	
КонецФункции

&НаКлиенте
Процедура ПроверкаВозможностиПечатиЗавершение(РезультатВопроса,ИмяМакета) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Объект.ДокументОснование.Пустая() И НЕ ПроведенДокументОснование() Тогда
		//Надо провести разрешение, а потом путевку
		Описание = Новый ОписаниеОповещения("ДокументОснованиеПроведение",ЭтаФорма,ИмяМакета);
		ПоказатьВопрос(Описание,"Необходимо сначала провести документ основание",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		Возврат;
	КонецЕсли;	
	
	Отказ = Ложь;
	Попытка
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи",РежимЗаписиДокумента.Проведение);
		Если НЕ ЭтаФорма.Записать(ПараметрыЗаписи) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ИнформацияОбОшибке().Описание);		
			Отказ  = Истина;		
		КонецЕсли;
		
		
	Исключение
		Отказ = Истина;
		Текст = ОписаниеОшибки(); 
		Поле = "Объект";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст,Поле);
		
	КонецПопытки;
	
	Если НЕ Отказ Тогда
		ОткрытьФормуПечати(ИмяМакета);
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ДокументОснованиеПроведение(РезультатВопроса,ИмяМакета) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗаписатьДокументОснование() Тогда
		Возврат;
	КонецЕсли;
	
	ПроверкаВозможностиПечатиЗавершение(КодВозвратаДиалога.Да,ИмяМакета)
КонецПроцедуры

&НаСервере
Функция ЗаписатьДокументОснование()
	
	ДокументОснование = Объект.ДокументОснование.ПолучитьОбъект();
	Попытка
		ДокументОснование.Записать();
		
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Если НЕ ВладелецФормы = Неопределено Тогда
		Если ТипЗнч(ВладелецФормы) = Тип("УправляемаяФорма") тогда
			Оповестить("СформироватьСтрокуПутевки",Объект.Ссылка,ЭтаФорма);
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ Объект.ДокументОснование.Пустая() И ПолучитьРеквизитДокумента(Объект.ДокументОснование,"ПутевкаДоговор").Пустая() Тогда
		УстановитьРеквизитВРазрешении();	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УстановитьРеквизитВРазрешении();	
	ДокРазрешение = Объект.ДокументОснование.ПолучитьОбъект();
	ДокРазрешение.ПутевкаДоговор = Объект.Ссылка;
	Попытка
		ДокРазрешение.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
	КонецПопытки;
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьРеквизитДокумента(СсылкаДокумента,ИмяРеквизита)
	Возврат СсылкаДокумента[ИмяРеквизита];	
КонецФункции	


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПроизвольныйПериодПриИзменении(Неопределено);
	Если НЕ ВладелецФормы = Неопределено И ТипЗнч(ВладелецФормы) = Тип("УправляемаяФорма") Тогда
		Элементы.ГруппаСезоннаяРазоваяПроизвольный.Видимость = ВладелецФормы.Элементы.ГруппаСезоннаяРазоваяПроизвольный.Видимость;
	КонецЕсли;	
	
	УстановитьДоступностьЭлементов();
	УстановитьЗаголовокДокументаОснования();
	Если НЕ ЗначениеЗаполнено(Объект.ВидДичи) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ПериодОхоты = ("с " + Формат(Объект.ДатаНачала, "ДФ ='дд.ММ.гггг'") + " по " +  Формат(Объект.ДатаОкончания, "ДФ ='дд.ММ.гггг'"));
		Элементы.ПериодОхоты.СписокВыбора.Добавить(ПериодОхоты,ПериодОхоты);
	КонецЕсли;
	
	УстановитьСуммуПрописью();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокДокументаОснования()
	Если НЕ Объект.ДокументОснование.Пустая() Тогда
		Элементы.НаименованиеДокументаОснования.Заголовок = Объект.ДокументОснование;
		Элементы.СерияРазрешения.Заголовок = "Серия " + Объект.СерияРазрешения;
		Элементы.НомерРазрешения.Заголовок = " Номер " +Объект.НомерРазрешения;
	Иначе
		Элементы.НаименованиеДокументаОснования.Заголовок = "Создать на основании";
		Элементы.НаименованиеДокументаОснования.Гиперссылка = Истина;
		Элементы.СерияРазрешения.Заголовок = "";
		Элементы.НомерРазрешения.Заголовок = "";
	КонецЕсли;	
	
КонецПроцедуры


