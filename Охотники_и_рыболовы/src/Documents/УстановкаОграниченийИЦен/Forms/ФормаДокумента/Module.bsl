#Область ТабличнаяЧастьСостав

&НаКлиенте
Процедура СоставПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ТекСтрока = ТекСтрока();
	Если ТекСтрока = Неопределено Тогда
		Отказ = Истина;
	Иначе
		Если НЕ ЗначениеЗаполнено(ТекСтрока.КлючСвязи) Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СоставПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	Если ПроверитьДаты(Элемент,Объект.Состав) Тогда
		ТекстВопроса = "Не заполнены обязательные поля. Удалить строку?";
		
		СоздатьОповещение(ТекстВопроса,"ПослеЗакрытияВопроса",Элемент);
		Возврат;
	КонецЕсли;	
	Если НЕ  (ЗначениеЗаполнено(Элемент.ТекущиеДанные.Дичь) 
			И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДатаНачала)
			И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДатаОкончания))  Тогда
		
		ТекстВопроса = "Не заполнены обязательные поля. Удалить строку?";
		СоздатьОповещение(ТекстВопроса,"ПослеЗакрытияВопроса",Элемент);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставГруппаПриИзменении(Элемент)
	ОграничитьСписокВыбора();
КонецПроцедуры

&НаКлиенте
Процедура СоставПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ЗаполнитьЗначенияСвойств(Элемент.ТекущиеДанные, ТекСтрока());
		Элементы.СоставДатаНачала.МинимальноеЗначение =  Элемент.ТекущиеДанные.ДатаНачала;
		Элементы.СоставДатаОкончания.МаксимальноеЗначение = Элемент.ТекущиеДанные.ДатаОкончания;
		
	КонецЕсли;	
	ОграничитьСписокВыбора();
КонецПроцедуры

&НаКлиенте
Процедура ОграничитьСписокВыбора()
	Элементы.СоставДичь.СписокВыбора.Очистить();
	Группа = Элементы.Состав.ТекущиеДанные.Группа;
	
	Если Группа Тогда
		Элементы.СоставДичь.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ГруппыДичи");
	Иначе	
		Элементы.СоставДичь.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Дичь");
	КонецЕсли;
	
	СписокДичи = ПолучитьСписокДичиНаСервере(ТекСтрока().ВидДичи,Элементы.Состав.ТекущиеДанные.Группа);
	ОбновитьПовторноИспользуемыеЗначения();
	
	
	Элементы.СоставДичь.СписокВыбора.ЗагрузитьЗначения(СписокДичи.ВыгрузитьЗначения());
КонецПроцедуры

&НаКлиенте
Процедура СоставОграниченоПриИзменении(Элемент)
	ТекДанные = Элементы.Состав.ТекущиеДанные;
	Если НЕ ТекДанные.Ограничено Тогда
		ТекДанные.КоличествоВДень = 0;
		ТекДанные.КоличествоЗаСезон = 0;
	КонецЕсли;
	
	УстановитьДоступностьКолонокКоличество(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СоставДатаНачалаПриИзменении(Элемент)
	
	ТекСтрока = Элемент.Родитель.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекСтрока.ДатаНачала < ОбщаяДатаНачала ИЛИ ТекСтрока.ДатаНачала > ОбщаяДатаОкончания Тогда
		ТекСтрока.ДатаНачала = ОбщаяДатаНачала;
		СообщитьНаСервере("Дата начала была изменена","Состав.ДатаНачала");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СоставДатаОкончанияПриИзменении(Элемент)
	
	ТекСтрока = Элемент.Родитель.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекСтрока.ДатаОкончания < ОбщаяДатаНачала ИЛИ ТекСтрока.ДатаОкончания > ОбщаяДатаОкончания Тогда
		ТекСтрока.ДатаНачала = ОбщаяДатаОкончания;
		СообщитьНаСервере("Дата окончания была изменена","Состав.ДатаОкончания");
	КонецЕсли;	

КонецПроцедуры


#КонецОбласти

