&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекущийСезон = ОхотаСерверПовтИсп.ПолучитьТекущийСезон();
	
	Если ТекущийСезон.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен сезон охоты.");
		Отказ = Истина;
	ИначеЕсли Объект.СезонОхоты.Пустая() Тогда
		Объект.СезонОхоты = ТекущийСезон;
	КонецЕсли;
	
	ДатаНачалаСезона = ТекущийСезон.ДатаНачала;
	ДатаОкончанияСезона = ТекущийСезон.ДатаОкончания;

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыДичи.Ссылка КАК ВидДичи,
		|	ПРЕДСТАВЛЕНИЕ(ВидыДичи.Ссылка) КАК Представление
		|ИЗ
		|	Справочник.ВидыДичи КАК ВидыДичи
		|ГДЕ
		|	НЕ ВидыДичи.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидыДичи.Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокВидовДичи.Добавить(Выборка.ВидДичи,Выборка.Представление);
	КонецЦикла;
	
	
	                                                          
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Элементы.ОбщаяДатаНачала.Подсказка = "Дата начала должна быть не раньше чем " + Формат(ДатаНачалаСезона,"ДЛФ=DD");
	Элементы.ОбщаяДатаОкончания.Подсказка = "Дата окончания должна быть не позже чем " + Формат(ДатаОкончанияСезона,"ДЛФ=DD");
КонецПроцедуры


/////////////////////////////////////////

#Область ТабличнаяЧастьОбщая
&НаКлиенте
Процедура ОбщаяПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Отказ = НайтиДублиСтрок();
	
	Если Отказ  Тогда
		Текст = "Есть полные дубли строк. Уточните данные";
		Поле =  "Объект.Общая"; //[" + Строка((Элемент.ТекущаяСтрока - 1)) + "].ВидДичи" ;	
		СообщитьНаСервере(Текст,Поле);
		Возврат;
	КонецЕсли;	
	
	Если ПроверитьДаты(Элемент,Объект.Общая) Тогда
		ТекстВопроса = "Не заполнены обязательные поля. Удалить строку?";
		СоздатьОповещение(ТекстВопроса,"ПослеЗакрытияВопроса",Элемент);
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ВидДичи) 
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДатаНачала)
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДатаОкончания) Тогда
		Если НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.КлючСвязи) Тогда
			Элемент.ТекущиеДанные.КлючСвязи = Новый УникальныйИдентификатор();
		КонецЕсли;	
	Иначе
		ПустаяСтрока = Истина;
		ТекстВопроса = "Не заполнены обязательные поля. Удалить строку?";
		СоздатьОповещение(ТекстВопроса,"ПослеЗакрытияВопроса",Элемент);
	КонецЕсли;
	
	
КонецПроцедуры


&НаКлиенте
Процедура ОбщаяПередУдалением(Элемент, Отказ)
	КлючСвязи = Элемент.ТекущиеДанные.КлючСвязи;
	Если ЗначениеЗаполнено(КлючСвязи) Тогда
		Строки = Объект.Состав.НайтиСтроки(Новый Структура("КлючСвязи",КлючСвязи));
		Если НЕ Строки.Количество() = 0 Тогда
			Описание = Новый ОписаниеОповещения("ОбщаяПередУдалениемЗавершение",ЭтаФорма,Строки);
			ПоказатьВопрос(Описание,"Есть связанные объекты?
									|Удалить?",РежимДиалогаВопрос.ДаНет,60,КодВозвратаДиалога.Да);
			Отказ = Истина;						
			Возврат;									
		КонецЕсли;
	КонецЕсли;
	Если Не Отказ Тогда
		Если НельзяДобавитьСтроку Тогда
			НельзяДобавитьСтроку = Ложь;
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбщаяПередУдалениемЗавершение(РезультатВопроса,Строки) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	КлючСвязи = Строки[0].КлючСвязи;
	Строка = Объект.Общая.НайтиСтроки(Новый Структура("КлючСвязи",КлючСвязи))[0];
	Объект.Общая.Удалить(Объект.Общая.Индекс(Строка));	
	
	Для каждого стр из Строки Цикл
		Объект.Состав.Удалить(Объект.Состав.Индекс(стр));	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщаяВидДичиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СписокВыбора = Элементы.ОбщаяВидДичи.СписокВыбора;	//
	СписокВыбора.ЗагрузитьЗначения(СписокВидовДичи.ВыгрузитьЗначения());
КонецПроцедуры

&НаКлиенте
Процедура ОбщаяПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если НельзяДобавитьСтроку Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Копирование Тогда
		Отказ = Истина;
		ВидДичи = Элемент.ТекущиеДанные.ВидДичи;
		Строки = Объект.Общая.НайтиСтроки(Новый Структура("ВидДичи",ВидДичи));
		
		Строка = Строки[0];
		
		ДобавляемаяСтрока = Объект.Общая.Добавить();
		ЗаполнитьЗначенияСвойств(ДобавляемаяСтрока,Строка,,"ДатаНачала,ДатаОкончания,КлючСвязи");
		Элементы.Общая.ТекущаяСтрока = ДобавляемаяСтрока.ПолучитьИдентификатор();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбщаяПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		ОбщаяДатаНачала = '00010101';
		ОбщаяДатаОкончания = '00010101';
		Возврат;
	КонецЕсли;	
	ОбщаяДатаНачала = Элемент.ТекущиеДанные.ДатаНачала;
	ОбщаяДатаОкончания = Элемент.ТекущиеДанные.ДатаОкончания;
	Элементы.Состав.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСвязи",Элемент.ТекущиеДанные.КлючСвязи));
КонецПроцедуры


&НаКлиенте
Процедура ОбщаяДатаНачалаПриИзменении(Элемент)
	Если НЕ Элемент.Родитель.ТекущиеДанные = Неопределено
			И Элемент.Родитель.ТекущиеДанные.ДатаНачала < ДатаНачалаСезона Тогда
		стр = Объект.Общая.Получить(Элементы.Общая.ТекущаяСтрока - 1);
		стр.ДатаНачала = ДатаНачалаСезона;
		СообщитьНаСервере("Дата начала была изменена","Общая.ДатаНачала");
	ОбщаяДатаНачала = стр.ДатаНачала;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщаяДатаОкончанияПриИзменении(Элемент)
	Если НЕ Элемент.Родитель.ТекущиеДанные = Неопределено
			И Элемент.Родитель.ТекущиеДанные.ДатаОкончания > ДатаОкончанияСезона Тогда
		стр = Объект.Общая.Получить(Элементы.Общая.ТекущаяСтрока - 1);
		стр.ДатаОкончания = ДатаОкончанияСезона;
		СообщитьНаСервере("Дата окончания была изменена","Общая.ДатаОкончания");
		ОбщаяДатаОкончания = стр.ДатаОкончания;
	КонецЕсли;	
КонецПроцедуры


#КонецОбласти

