#Область Вспомогательные

&НаКлиенте
Функция ПроверитьДаты(Элемент,ТабличнаяЧасть) Экспорт
	Отказ = Ложь;
	
	ОтборПоКлючуСвязи = Новый Структура("КлючСвязи",Элемент.ТекущиеДанные.КлючСвязи);
	НайдСтроки = ТабличнаяЧасть.НайтиСтроки(ОтборПоКлючуСвязи);
	
	Если НайдСтроки.Количество() > 1 Тогда
		Для инд = 1 по НайдСтроки.Количество() - 1 Цикл
			СтрокаОбщая = НайдСтроки[инд];
			
			ИскСтроки = Объект.Состав.НайтиСтроки(ОтборПоКлючуСвязи);
			Если ИскСтроки.Количество() > 1 Тогда
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
	
	НомерСтроки = НайдСтроки[0].НомерСтроки;
	
	ДатаНачала = ТабличнаяЧасть[НомерСтроки - 1].ДатаНачала;
	ДатаОкончания = ТабличнаяЧасть[НомерСтроки -  1].ДатаОкончания;
	
	ТекСтрокаОбщая = ТекСтрока();
	
	Если Элемент.Имя = "Общая" Тогда
		ДатаСравненияНачала = ДатаНачалаСезона;
		ДатаСравненияОкончания = ДатаОкончанияСезона;
		
		Поле =  "Объект.Общая"; //[" + Строка((Элемент.ТекущаяСтрока - 1)) + "].ВидДичи" ;
	Иначе
		ДатаСравненияНачала = ДатаНачалаСезона;
		ДатаСравненияОкончания = ДатаОкончанияСезона;
		
		Поле = 	"Объект.Состав"; //[" + Строка((Элемент.ТекущаяСтрока - 1)) + "].Дичь" ;
	КонецЕсли;
	

	Если  ДатаНачала = '00010101' Тогда
		Возврат Истина;
	ИначеЕсли	ДатаОкончания = '00010101' Тогда
		Возврат Истина;
	ИначеЕсли 	ДатаНачала <  ДатаСравненияНачала Тогда
		Текст = "Некорректная дата начала";
	ИначеЕсли 	ДатаНачала > ДатаОкончания Тогда
		Текст = "Некорректная дата начала или дата окончания";
	ИначеЕсли 	ДатаОкончания >  ДатаСравненияОкончания Тогда
		Текст = "Некорректная дата окончания";
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Текст) Тогда
		Отказ = Истина;
		СообщитьНаСервере(Текст, Поле );
	КонецЕсли;
	Возврат Отказ;
КонецФункции

&НаКлиенте
Процедура СоздатьОповещение(ТекстВопроса,ПроцедураОбработки,Элемент) 
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения(ПроцедураОбработки, ЭтаФорма, Элемент);
	ПоказатьВопрос(Оповещение,ТекстВопроса , Режим, 0);

КонецПроцедуры

&НаКлиенте 
Процедура ПослеЗакрытияВопроса(Результат, Элемент) Экспорт
	ИмяТабличнойЧасти = Элемент.Имя;
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Если Элемент.Имя = "Общая" Тогда
			НельзяДобавитьСтроку = Истина;
		КонецЕсли;	
		Возврат;		                               
	Иначе
		Отказ = Ложь;
		     ///// проверим возможность удаления в таблице общая
		Если ИмяТабличнойЧасти = "Общая" Тогда
			ОбщаяПередУдалением(Элемент,Отказ);
		КонецЕсли;
		
		Если НЕ Отказ Тогда 
			Объект[ИмяТабличнойЧасти].Удалить(Элемент.ТекущиеДанные.НомерСтроки-1);
			НельзяДобавитьСтроку = Ложь;
		Иначе
			Элементы.Общая.ТекущийЭлемент = Элемент;//установим фокус обратно
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокДичиНаСервере(ТекВидДичи,Группа)
	Возврат ОхотаСерверПовтИсп.ПолучитьСписокДичи(ТекВидДичи,Группа);
КонецФункции

&НаКлиенте
Функция ТекСтрока()
	ТекСтрока = Элементы.Общая.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат  ТекСтрока;
	КонецЕсли;	
КонецФункции

&НаСервере
Функция НайтиДублиСтрок() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабЧасть.ВидДичи,
		|	ТабЧасть.ДатаНачала,
		|	ТабЧасть.ДатаОкончания,
		|	1 КАК Поле1
		|ПОМЕСТИТЬ ВТ1
		|ИЗ
		|	&ТабЧасть КАК ТабЧасть
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ1.ВидДичи,
		|	ВТ1.ДатаНачала,
		|	ВТ1.ДатаОкончания,
		|	СУММА(ВТ1.Поле1) КАК Поле1
		|ИЗ
		|	ВТ1 КАК ВТ1
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ1.ВидДичи,
		|	ВТ1.ДатаНачала,
		|	ВТ1.ДатаОкончания
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВТ1.Поле1) > 1";
		
	ТабЧасть = Объект.Общая.Выгрузить();	
	Запрос.УстановитьПараметр("ТабЧасть",ТабЧасть);	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
		
КонецФункции

&НаСервереБезКонтекста
Процедура СообщитьНаСервере(Текст,Поле)
	ОхотаСервер.ПоказатьСообщение(Текст,Поле);	
КонецПроцедуры

&НаКлиенте
Процедура СоставКоличествоВДеньПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные.КоличествоВДень > 0 
		И ТекущиеДанные.КоличествоЗаСезон > 0 Тогда
		ТекущиеДанные.КоличествоЗаСезон = 0;
	КонецЕсли;
	
	СоставОграниченоПриИзменении(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СоставКоличествоЗаСезонПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные.КоличествоЗаСезон > 0 
		И ТекущиеДанные.КоличествоВДень > 0 Тогда
		ТекущиеДанные.КоличествоВДень = 0;
	КонецЕсли;	
	СоставОграниченоПриИзменении(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СоставПриАктивизацииСтроки(Элемент)
	УстановитьДоступностьКолонокКоличество(Элемент.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКолонокКоличество(ТекДанные)
	Если ТекДанные = Неопределено ИЛИ НЕ ТекДанные.Ограничено Тогда
		Элементы.СоставКоличествоВДень.ТолькоПросмотр = Истина;
		Элементы.СоставКоличествоЗаСезон.ТолькоПросмотр = Истина;
	Иначе
		Элементы.СоставКоличествоВДень.ТолькоПросмотр = Ложь;
		Элементы.СоставКоличествоЗаСезон.ТолькоПросмотр = Ложь;
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти


